  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch-path=src -r ts-node/register src/main.ts",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "seed": "prisma db seed",
    "dev:login": "ts-node scripts/dev-login.ts",
    "dev:order-demo": "ts-node scripts/dev-order-demo.ts",
    "staff:add": "ts-node scripts/add-staff.ts",
    "bootstrap:prod": "ts-node scripts/bootstrap-production.ts",
    "import:products": "ts-node scripts/import-products.ts",
    "import:yandex": "ts-node scripts/import-yandex.ts",
    "backfill:dictionaries": "ts-node scripts/backfill-dictionaries.ts",
    "import:catalog": "ts-node scripts/import-catalog.ts",
    "import:yandex-aliases": "ts-node scripts/import-yandex-aliases.ts",
    "orders:attach-units": "ts-node scripts/attach-order-units.ts",
    "orders:mark-test": "ts-node scripts/mark-test-orders.ts",
    "server:after-transfer": "ts-node scripts/after-transfer.ts",
    "import:opening-stock": "ts-node scripts/import-opening-stock.ts",
    "reconcile:units": "ts-node scripts/reconcile-units.ts",
    "photos:optimize": "ts-node scripts/optimize-photos.ts",
    "brand:icons": "ts-node scripts/brand-icons.ts",
