# ШАБЛОН файла настроек магазина НА СЕРВЕРЕ: /opt/vitalo/app/apps/api/.env  (его читают и API, и бот).
# Здесь только имена и безопасные значения. Настоящие значения вписываются на сервере (nano) и никогда не попадают
# в git, в чат или на скриншоты. Права файла: chmod 600, владелец vitalo.
# Пошагово: docs/DEPLOY_RUNBOOK.md, фаза 4.
#
# Пометки:  [СЕКРЕТ]   — вписать самому на сервере, никому не показывать
#           [ГОТОВО]   — менять не нужно
#           [ПОЗЖЕ]    — меняется на отдельном шаге инструкции

# ---------------------------------------------------------------- режим
# [ГОТОВО] production: выключены тестовое заполнение базы (seed), dev-скрипты и документация API.
NODE_ENV=production
# [ГОТОВО] API слушает только сам сервер; снаружи к нему ведёт только nginx.
HOST=127.0.0.1
PORT=3000

# ---------------------------------------------------------------- база данных
# [ГОТОВО] PostgreSQL через локальный сокет от имени системного пользователя vitalo: пароля нет и хранить его негде.
DATABASE_URL=postgresql://vitalo@localhost/vitalo?host=/var/run/postgresql

# ---------------------------------------------------------------- Telegram
# [СЕКРЕТ] Токен БОЕВОГО бота @vitalo_uz_bot из @BotFather (НЕ тестового).
TELEGRAM_BOT_TOKEN=
# [СЕКРЕТ] Общий секрет бота и API. Создаётся на сервере командой из инструкции (openssl rand -hex 32).
#          При переезде — НОВЫЙ, не тот, что на компьютере.
BOT_API_SECRET=
# ID группы Telegram для сообщений об ошибках (например -1001234567890). Пусто = без оповещений.
TECH_CHAT_ID=
# [ГОТОВО] Бот обращается к API по этому адресу (именно 127.0.0.1: API слушает только IPv4).
API_INTERNAL_URL=http://127.0.0.1:3000/api

# ---------------------------------------------------------------- адреса
# [ГОТОВО] Mini App (магазин) и админка. С этими адресами бот ставит кнопку «Магазин» и отвечает на /admin.
#          Раз адреса заданы здесь, туннель (Cloudflare) на сервере не нужен и не запускается.
MINIAPP_URL=https://vitalo.uz
ADMIN_URL=https://admin.vitalo.uz
CORS_ORIGINS=https://vitalo.uz,https://admin.vitalo.uz

# ---------------------------------------------------------------- фото товаров
# [ГОТОВО] Папка с фото (её раздаёт nginx по адресу /uploads/).
UPLOAD_DIR=/var/lib/vitalo/uploads
PUBLIC_UPLOADS_URL=/uploads
# [ГОТОВО, 3.1] Чеки покупателей (перевод на карту). Закрытая папка: nginx её не раздаёт, backup.sh её копирует.
# Если строки нет — берётся папка receipts рядом с UPLOAD_DIR, то есть /var/lib/vitalo/receipts.
# RECEIPTS_DIR=/var/lib/vitalo/receipts

# ---------------------------------------------------------------- входы
# [ГОТОВО] Сколько часов действует вход покупателя и сотрудника; сколько секунд годится подпись Telegram.
SESSION_TTL_HOURS=720
STAFF_SESSION_TTL_HOURS=12
INIT_DATA_MAX_AGE_SECONDS=86400

# ---------------------------------------------------------------- фоновые задачи
# [ГОТОВО] Резерв 12 часов, напоминания об оплате, очередь сообщений, напоминания о налоге и зарплатах (12-го и 14-го),
#          опрос Яндекса. Работают внутри API; включены ровно на одном сервере.
JOBS_ENABLED=true
# [ГОТОВО] Документация API (/api/docs) в магазине закрыта.
API_DOCS=false

# ---------------------------------------------------------------- Яндекс Маркет (только чтение)
# [СЕКРЕТ] Токен кабинета продавца, НОВЫЙ, с правом только на чтение заказов
#          («inventory-and-order-processing:read-only»). Старый токен с компьютера после переезда отозвать.
YANDEX_API_KEY=
# [ГОТОВО] Кабинет и магазин (кампания VITALO_h).
YANDEX_BUSINESS_ID=216755072
YANDEX_CAMPAIGN_IDS=149165806
# [ПОЗЖЕ]  Опрос Яндекса. Сначала false; включается на шаге «Яндекс» инструкции.
YANDEX_SYNC_ENABLED=false
# [ПОЗЖЕ]  true = только журнал «что было бы сделано», заказы не создаются. false ставится после проверки журнала.
YANDEX_SYNC_DRY_RUN=true
# [ГОТОВО] Опрос раз в 5 минут за последние 3 дня (первый раз — за 14).
YANDEX_SYNC_INTERVAL_MINUTES=5
YANDEX_SYNC_DAYS=3
YANDEX_SYNC_FIRST_DAYS=14
# [ПОЗЖЕ]  Уведомления от Яндекса (фаза 6). Адрес для кабинета Яндекса:
#          https://api.vitalo.uz/api/yandex/notifications/<YANDEX_WEBHOOK_SECRET>
YANDEX_WEBHOOK_ENABLED=false
# [СЕКРЕТ] Создаётся на сервере командой из инструкции (не короче 16 символов). Это часть адреса — никому не показывать.
YANDEX_WEBHOOK_SECRET=
# [ГОТОВО] Принимать уведомления только с адресов Яндекса (5.45.207.0/25, 141.8.142.0/25, 5.255.253.0/25).
#          false — только на минуту для ручной проверки, потом вернуть true.
YANDEX_WEBHOOK_CHECK_IP=true

# --- Online payments Payme / Click / Uzum (D-20, stage 2.1). Leave empty until a contract and a module exist:
# empty = only «Скрыта» / «Скоро» in Настройки → Оплата. Values never go to docs, git or messages. ---
PAYME_MERCHANT_ID=
# Payme (Merchant API): the key of the cash desk. Payme calls https://api.vitalo.uz/api/payments/payme
# Payme key: always in single quotes, PAYME_KEY='...' — a # in the key otherwise starts a comment and the key is cut
PAYME_KEY=
# true = the Payme sandbox (checkout.test.paycom.uz) with the TEST key; false = real payments with the live key
PAYME_TEST_MODE=false
# Receipt line «Доставка» (not secret): ИКПУ and package code of the delivery service; VAT % for every line
PAYME_DELIVERY_IKPU=
PAYME_DELIVERY_PACKAGE_CODE=
PAYME_VAT_PERCENT=0
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
UZUM_SERVICE_ID=
UZUM_SECRET=

# ---------------------------------------------------------------- Яндекс Карты (3.6, «Выбрать на карте»)
# [СЕКРЕТ] Ключ «JavaScript API» (кабинет разработчика Яндекса). Виден в браузере покупателя, поэтому в кабинете
#          ограничить по адресам сайта (HTTP Referer): vitalo.uz, localhost, *.trycloudflare.com.
YANDEX_MAPS_JS_API_KEY=
# [СЕКРЕТ] Ключ «API Геокодера». Запросы идут только с нашего сервера; в кабинете ограничить по IP сервера.
#          Бесплатно — 1000 запросов в сутки: магазин сам прячет карту на 900 (Настройки → Доставка).
YANDEX_GEOCODER_API_KEY=
