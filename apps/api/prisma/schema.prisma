  enabled       Boolean   @default(true)
  sort_order    Int       @default(0)
  image_ru_url  String?
  image_ru_jpeg String?
  image_uz_url  String?
  image_uz_jpeg String?
  /// product | category | brand; null = the banner is not a link
  link_type     String?
  /// product id, category slug or brand name
  link_value    String?
  starts_at     DateTime?
  ends_at       DateTime?
  created_at    DateTime  @default(now())
