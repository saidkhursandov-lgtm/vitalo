/// Internal funnel analytics (B3): app_open, product_view, add_to_cart, checkout_start, order_created, payment_marked, payment_confirmed.
model analytics_events {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  event      String
  props      Json?
  created_at DateTime @default(now())
  user       users    @relation(fields: [user_id], references: [id])

  @@index([event, created_at])
  @@index([user_id, created_at])
}

// ───────────── «ПОД ЗАКАЗ ИЗ США» (D-60) ─────────────
/// «Посылка из США»: one order on iHerb for several customers' lines. stage: ordered | shipped | arrived_uz | received.
model cross_border_batches {
  id            String    @id @default(uuid()) @db.Uuid
  number        Int       @unique @default(autoincrement())
  stage         String    @default("ordered")
  purchase_id   String?   @db.Uuid
  note          String?
  ordered_at    DateTime  @default(now())
  shipped_at    DateTime?
  arrived_uz_at DateTime?
  received_at   DateTime?
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt

  supplier_id String?               @db.Uuid
  purchase    purchases?            @relation(fields: [purchase_id], references: [id])
  staff       staff_users?          @relation(fields: [created_by], references: [id])
  supplier    suppliers?            @relation(fields: [supplier_id], references: [id])
  items       order_items[]
  events      cross_border_events[]

  @@index([stage, created_at])
}

/// The customer's timeline of an order from the USA: type stage (ordered | shipped | arrived_uz | in_stock) or delay.
model cross_border_events {
  id            String    @id @default(uuid()) @db.Uuid
  order_id      String    @db.Uuid
  batch_id      String?   @db.Uuid
  type          String
  stage         String?
  expected_from DateTime? @db.Date
  expected_to   DateTime? @db.Date
  reason        String?
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now())

  order orders                @relation(fields: [order_id], references: [id], onDelete: Restrict)
  batch cross_border_batches? @relation(fields: [batch_id], references: [id])
  staff staff_users?          @relation(fields: [created_by], references: [id])

  @@index([order_id, created_at])
}

/// 6а-Д (D-62): «Спросить специалиста» in the Mini App — one question of a customer and its conversation.
/// The text may hold health data (topic medical): only admins and specialists see medical threads (D-40).
model support_threads {
  id              String             @id @default(uuid()) @db.Uuid
  user_id         String             @db.Uuid
  /// medical | order | promo | tech
  topic           String
  /// the product the question came from (the product card attaches it by itself)
  product_id      String?            @db.Uuid
  /// open (waits for the shop) | answered (the shop replied last) | closed
  status          String             @default("open")
  lang            String             @default("ru")
  /// shop replies the customer has not opened yet
  customer_unread Int                @default(0)
  last_message_at DateTime           @default(now())
  created_at      DateTime           @default(now())
  /// 6б-Б: the request number the customer and the staff see («Обращение №0012»)
  number          Int                @unique @default(autoincrement())
  /// 6б-Б: the order the request is about (chosen by the customer or «Написать покупателю» in the admin)
  order_id        String?            @db.Uuid
  /// customer | staff (the shop wrote first from the order card)
  started_by      String             @default("customer")
  closed_at       DateTime?
  closed_by       String?            @db.Uuid
  /// 1–5 stars the customer gave after the request was closed
  rating          Int?               @db.SmallInt
  rated_at        DateTime?
  user            users              @relation(fields: [user_id], references: [id])
  product         products?          @relation(fields: [product_id], references: [id], onDelete: SetNull)
  order           orders?            @relation(fields: [order_id], references: [id], onDelete: SetNull)
  closer          staff_users?       @relation("support_closed_by", fields: [closed_by], references: [id], onDelete: SetNull)
  messages        support_messages[]

  @@index([user_id])
  @@index([order_id])
  @@index([status, last_message_at])
}

model support_messages {
  id            String          @id @default(uuid()) @db.Uuid
  thread_id     String          @db.Uuid
  /// customer | staff
  author        String
  staff_user_id String?         @db.Uuid
  text          String
  created_at    DateTime        @default(now())
  thread        support_threads @relation(fields: [thread_id], references: [id])
  staff         staff_users?    @relation(fields: [staff_user_id], references: [id], onDelete: SetNull)

  @@index([thread_id, created_at])
}

/// Шаг 0б (D-69, архитектура 3.6): «вещество → цель → уровень доказательности → когда помогает / когда нет». Заполняет и
/// одобряет врач («База знаний AI → Цели»); в ответ VITALO AI «Поможет ли этот набор для моей цели?» попадают только
/// одобренные строки. Уровень A/B/C — только здесь и в админке; покупатель видит его словами (D-67).
model goal_evidence {
  id           String       @id @default(uuid()) @db.Uuid
  substance_id String       @db.Uuid
  goal         String // sleep | stress | energy | joints | immunity | sport
  level        String // A | B | C
  helps_ru     String
  helps_uz     String
  not_helps_ru String
  not_helps_uz String
  /// study, «комментарий врача»; staff only
  source       String?
  status       String       @default("draft") // draft | approved | off
  approved_by  String?      @db.Uuid
  approved_at  DateTime?
  created_by   String?      @db.Uuid
  created_at   DateTime     @default(now())
  updated_at   DateTime     @default(now()) @updatedAt
  substance    substances   @relation(fields: [substance_id], references: [id])
  approver     staff_users? @relation("GoalEvidenceApprover", fields: [approved_by], references: [id], onDelete: SetNull)

  @@unique([substance_id, goal])
  @@index([goal, status])
}

/// Аудит админки 4.1: a staff note about a customer (never deleted, like the audit log).
model customer_notes {
  id            String      @id @default(uuid()) @db.Uuid
  user_id       String      @db.Uuid
  staff_user_id String      @db.Uuid
  text          String
  created_at    DateTime    @default(now())
  user          users       @relation(fields: [user_id], references: [id])
  staff         staff_users @relation(fields: [staff_user_id], references: [id])

  @@index([user_id, created_at])
}
