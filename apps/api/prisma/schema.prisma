// VITALO — Prisma schema (Stage 1). Based on Appendix 1 (ER).
// Money = BigInt UZS. Timestamps = UTC. Field names follow the ER document (snake_case).
//
// Deviations from Appendix 1 (to be confirmed, see README "Решения по ТЗ"):
//  - orders.delivery_status removed: duplicated orders.status (handed/in_transit/delivered).
//  - added shipments (merging orders into one physical delivery, Master TZ §11).
//  - added settings, cancel_requests, manager_tasks, notifications, order_number_counters,
//    marketing_recipients, return_media, bank_transfer_details (needed by TZ, absent in ER).
//  - inventory.available_qty is NOT stored: available = actual_qty - reserved_qty (DB view/computed).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent]
}

// ───────────── ENUMS ─────────────
enum UserStatus {
  active
  blocked
  deleting
  deleted
}

enum Lang {
  ru
  uz
}

enum EntityStatus {
  active
  archived
}

enum StaffRole {
  admin
  manager
  warehouse
  marketer
}

enum StaffStatus {
  active
  blocked
}

enum TreeType {
  need
  product_type
}

enum ProductStatus {
  active
  archived
  hidden
}

enum MediaType {
  image
  document
}

enum RelationType {
  similar
  also_bought
}

enum MovementType {
  receipt
  reserve
  release
  deduct
  writeoff
  return_to_stock
  adjustment
}

enum CartStatus {
  active
  converted
  abandoned
}

enum OrderStatus {
  new
  awaiting_payment
  paid
  picking
  handed_to_delivery
  in_transit
  delivered
  cancelled
  return
}

enum PaymentStatus {
  payment_pending
  payment_success
  payment_failed
  payment_cancelled
}

enum AttemptStatus {
  pending
  success
  failed
  cancelled
}

enum PaymentMethodStatus {
  enabled
  disabled
}

enum PromoType {
  percent
  fixed
  free_delivery // 3.3
}

enum StackingMode {
  compatible
  exclusive
}

enum PromoStatus {
  draft
  active
  disabled
  expired
}

enum PromoScope {
  order
  product
  category
  brand
}

enum PromoUsageStatus {
  reserved
  consumed
  rolled_back
}

/// 3.7: a promotions row is a promo code (codes) or a sale with its own prices (campaign)
enum PromotionKind {
  code
  campaign
}

/// 3.7: how a sale looks in the shop (badge, price colour)
enum CampaignSkin {
  none
  black_friday
  eleven_eleven
  sale
}

enum PromoCodeStatus {
  active
  disabled
}

enum BonusOp {
  purchase
  referral
  promo
  manual_add
  manual_subtract
  redemption
  reversal
  /// 3.10-А: the balance burnt after the lifetime (bonus_accounts.last_activity_at + lifetime_days)
  expire
  /// 3.10-Б: a published review
  review
}

/// 3.10-Б: pending — waits for moderation; published — on the product card (the bonus is posted); rejected — not shown;
/// hidden — was published, then taken off the card by staff (the bonus stays)
enum ReviewStatus {
  pending
  published
  rejected
  hidden
}

enum ReferralStatus {
  pending
  qualified
  rejected
}

enum TariffStatus {
  active
  disabled
}

enum ReturnStatus {
  requested
  approved
  rejected
  refunded
  closed
}

enum ReturnReason {
  damaged
  wrong_item
  not_as_described
  unsuitable
  changed_mind
  other
}

enum ReturnCondition {
  resellable
  damaged
  opened
  other
}

enum ContentBlockType {
  hero
  promotion
  popular
  categories
  special_offers
  new_arrivals
}

enum ClickTarget {
  product
  category
  promotion
  collection
  external_url
}

enum ContentStatus {
  active
  disabled
}

enum SegmentType {
  all
  new
  one_time
  repeat
  inactive
  bonus_holders
  promo_users
  referral_participants
}

enum CampaignStatus {
  draft
  previewed
  sending
  completed
  cancelled
}

enum LegalStatus {
  draft
  active
  archived
}

enum ActorType {
  system
  staff
  customer
}

enum CancelRequestStatus {
  requested
  approved
  rejected
}

enum TaskStatus {
  open
  in_progress
  done
}

enum TaskType {
  payment_check
  bank_transfer_check
  refund
  other
}

/// Stage 2A: where a purchase comes from.
enum PurchaseSourceType {
  OZON
  SUPPLIER
}

/// Stage 2A: only two statuses; «отменена полностью» is computed from the lines, not stored.
enum PurchaseStatus {
  EXPECTED
  RECEIVED
}

/// Stage 2B: life of one physical jar. 2B uses RECEIVED, IN_STOCK, VOIDED; the rest are for the next stages.
enum PhysicalUnitStatus {
  RECEIVED
  IN_STOCK
  ASSIGNED
  YANDEX_DELIVERY
  YANDEX_SOLD
  VITALO_DELIVERY
  VITALO_SOLD
  RETURNED
  MISSING
  WRITTEN_OFF
  VOIDED

  @@map("physical_unit_status")
}

/// Stage 2B: receiving by purchase (Ozon account / supplier) or the opening balance (stock count sheet).
enum ReceivingSessionType {
  PURCHASE
  OPENING_BALANCE

  @@map("receiving_session_type")
}

enum ReceivingSessionStatus {
  OPEN
  COMPLETED
  CANCELLED

  @@map("receiving_session_status")
}

// ───────────── IDENTITY ─────────────
model users {
  id               String     @id @default(uuid()) @db.Uuid
  telegram_user_id BigInt     @unique
  status           UserStatus @default(active)
  is_test          Boolean    @default(false) // аудит 10.11, п. 1.5: тестовый клиент, скрыт в списках
  first_name       String
  last_name        String?
  username         String?
  phone            String?
  language         Lang       @default(ru)
  marketing_opt_in Boolean    @default(true)
  /// 3.8: one consent for every VITALO AI scenario (D-45); null = not asked yet
  ai_consent_at    DateTime?
  /// D-70: the consent to VITALO AI that says the conversation is kept (12 months); asked once more from those who agreed before
  ai_chat_consent_at DateTime?
  /// 3.10-Б: «Просить оставить отзыв» — the bot asks 3 days after the delivery (switched off in the profile)
  review_requests  Boolean    @default(true)
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  deleted_at       DateTime?

  sessions          user_sessions[]
  addresses         addresses[]
  carts             carts[]
  orders            orders[]
  favorites         favorites[]
  bonus_account     bonus_accounts?
  referrals         referrals[]
  referral_attr     referral_attributions?
  analytics_events  analytics_events[]
  returns           returns[]
  legal_acceptances legal_acceptances[]
  promotion_usages  promotion_usages[]
  notifications     notifications[]
  cancel_requests   cancel_requests[]
  waitlist          product_waitlist[]
  payment_receipts  payment_receipts[]
  compat_requests   compat_requests[]
  support_threads   support_threads[]
  notes             customer_notes[]
  ai_chats          ai_chats[]
  reviews           reviews[]

  @@index([status])
}

model user_sessions {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique
  device_info String?
  created_at  DateTime  @default(now())
  expires_at  DateTime
  revoked_at  DateTime?
  user        users     @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model regions {
  id         String             @id @default(uuid()) @db.Uuid
  name_ru    String
  name_uz    String
  status     EntityStatus       @default(active)
  /// Classifier SOATO (Agency of statistics), e.g. 1727 — Tashkent region
  soato_code String?            @unique
  cities     cities[]
  addresses  addresses[]
  orders     orders[]
  tariffs    delivery_tariffs[]
}

model cities {
  id         String             @id @default(uuid()) @db.Uuid
  region_id  String             @db.Uuid
  name_ru    String
  name_uz    String
  status     EntityStatus       @default(active)
  /// Classifier SOATO, e.g. 1727265 — Tashkent district; null for towns added by hand
  soato_code String?            @unique
  region     regions            @relation(fields: [region_id], references: [id])
  addresses  addresses[]
  orders     orders[]
  tariffs    delivery_tariffs[]

  @@index([region_id])
}

model addresses {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  label        String?
  region_id    String    @db.Uuid
  city_id      String    @db.Uuid
  address_text String
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  /// 3.6: typed by the customer next to the street from the map (the order gets them inside address_text)
  apartment    String?
  entrance     String?
  floor        String?
  landmark     String?
  is_primary   Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  user         users     @relation(fields: [user_id], references: [id])
  region       regions   @relation(fields: [region_id], references: [id])
  city         cities    @relation(fields: [city_id], references: [id])

  // one primary per user: partial unique index in raw SQL (constraints.sql)
  @@index([user_id])
}

model staff_users {
  id               String      @id @default(uuid()) @db.Uuid
  telegram_user_id BigInt      @unique
  name             String
  role             StaffRole
  status           StaffStatus @default(active)
  /// 3.4: answers «Проверить совместимость» (an admin answers anyway)
  is_specialist    Boolean     @default(false)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  sessions              staff_sessions[]
  devices               staff_devices[]
  login_requests        staff_login_requests[]
  backup_codes          staff_backup_codes[]
  audit_logs            audit_logs[]
  order_edits           order_edit_log[]
  movements             inventory_movements[]
  campaigns             marketing_campaigns[]
  ledger                bonus_ledger[]
  returns_approved      returns[]
  manual_payments       manual_payment_confirmations[]
  tasks                 manager_tasks[]
  cancel_decisions      cancel_requests[]
  notifications         notifications[]
  purchases             purchases[]
  purchase_events       purchase_events[]
  receiving             receiving_sessions[]
  unit_events           physical_unit_events[]
  compat_rules_approved compat_rules[]                 @relation("RuleApprover")
  goals_approved        goal_evidence[]                @relation("GoalEvidenceApprover")
  ai_chats_reviewed     ai_chats[]                     @relation("AiChatReviewer")
  ai_answers_reviewed   ai_compat_answers[]
  customer_notes        customer_notes[]
  marketplace_orders    marketplace_orders[]
  reviewed_receipts     payment_receipts[]
  moderated_reviews     reviews[]                      @relation("ReviewModerator")
  replied_reviews       reviews[]                      @relation("ReviewReplier")
  compat_answered       compat_requests[]
  compat_saved          compat_answers[]
  iherb_uploads         iherb_uploads[]
  price_changes         price_changes[]
  competitor_prices     competitor_prices[]
  admin_ai_feed         admin_ai_feed[]
  cross_border_batches  cross_border_batches[]
  cross_border_events   cross_border_events[]
  admin_ai_memory       admin_business_memory[]
  admin_ai_requests     admin_ai_requests[]
  support_messages      support_messages[]
  support_closed        support_threads[]              @relation("support_closed_by")
}

model staff_sessions {
  id            String      @id @default(uuid()) @db.Uuid
  staff_user_id String      @db.Uuid
  token_hash    String      @unique
  created_at    DateTime    @default(now())
  expires_at    DateTime
  revoked_at    DateTime?
  /// Генплан, этап 3: telegram (inside the bot) | web (Telegram Login Widget at admin.vitalo.uz) | backup (owner's code)
  kind          String      @default("telegram")
  /// the confirmed browser the web session belongs to
  device_id     String?     @db.Uuid
  device_name   String?
  ip            String?
  last_seen_at  DateTime?
  staff_user    staff_users @relation(fields: [staff_user_id], references: [id])

  @@index([staff_user_id])
}

/// Генплан, этап 3: a browser the employee confirmed in the bot; its random token is in an HttpOnly cookie
model staff_devices {
  id            String      @id @default(uuid()) @db.Uuid
  staff_user_id String      @db.Uuid
  token_hash    String      @unique
  name          String
  created_at    DateTime    @default(now())
  last_seen_at  DateTime?
  revoked_at    DateTime?
  staff_user    staff_users @relation(fields: [staff_user_id], references: [id])

  @@index([staff_user_id])
}

/// Генплан, этап 3: «Вход с нового устройства — Подтвердить / Это не я» in the bot. status: pending | approved | denied
model staff_login_requests {
  id                String      @id @default(uuid()) @db.Uuid
  staff_user_id     String      @db.Uuid
  poll_hash         String
  device_name       String
  ip                String?
  status            String      @default("pending")
  created_at        DateTime    @default(now())
  expires_at        DateTime
  decided_at        DateTime?
  session_issued_at DateTime?
  staff_user        staff_users @relation(fields: [staff_user_id], references: [id])

  @@index([staff_user_id])
}

/// Генплан, этап 3: the owner's one-time emergency codes (only hashes)
model staff_backup_codes {
  id            String      @id @default(uuid()) @db.Uuid
  staff_user_id String      @db.Uuid
  code_hash     String      @unique
  created_at    DateTime    @default(now())
  used_at       DateTime?
  revoked_at    DateTime?
  staff_user    staff_users @relation(fields: [staff_user_id], references: [id])

  @@index([staff_user_id])
}

// ───────────── CATALOG ─────────────
model categories {
  id             String                @id @default(uuid()) @db.Uuid
  parent_id      String?               @db.Uuid
  tree_type      TreeType
  name_ru        String
  name_uz        String
  slug           String                @unique
  sort_order     Int                   @default(0)
  status         EntityStatus          @default(active)
  /// 2.2: a hidden old category points to the one that replaced it (old links and banners keep working)
  merged_into_id String?               @db.Uuid
  parent         categories?           @relation("CatTree", fields: [parent_id], references: [id])
  children       categories[]          @relation("CatTree")
  merged_into    categories?           @relation("CatMerge", fields: [merged_into_id], references: [id])
  merged_from    categories[]          @relation("CatMerge")
  products       product_categories[]
  promo_targets  promotion_targets[]
  block_items    content_block_items[]

  @@index([parent_id, tree_type])
}

model products {
  id                   String        @id @default(uuid()) @db.Uuid
  sku                  String        @unique
  name_ru              String
  name_uz              String?
  // 2.1: optional short name for the cart, checkout, orders and messages; the full name stays on the card and in search
  short_name_ru        String?
  short_name_uz        String?
  brand                String
  manufacturer         String
  country              String?
  form                 String?
  price_uzs            BigInt
  old_price_uzs        BigInt?
  cost_uzs             BigInt?
  min_stock            Int           @default(0)
  status               ProductStatus @default(active)
  short_description_ru String?
  short_description_uz String?
  composition_ru       String?
  composition_uz       String?
  nutrition_ru         String?
  nutrition_uz         String?
  directions_ru        String?
  directions_uz        String?
  warnings_ru          String?
  warnings_uz          String?
  search_keywords      String?
  popularity_30d       Int           @default(0) // recalculated daily (30-day sold units)
  is_test              Boolean       @default(false) // аудит 10.11, п. 1.5: тестовый товар, скрыт в списках и сводках
  shipping_weight_g    Int?
  shipping_length_mm   Int?
  shipping_width_mm    Int?
  shipping_height_mm   Int?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  // Stage 1: dictionaries. The text columns brand / manufacturer / country / form stay and keep feeding the
  // Mini App; when a dictionary value is chosen, its name is copied into them (and on rename).
  brand_id        String? @db.Uuid
  manufacturer_id String? @db.Uuid
  country_id      String? @db.Uuid
  form_id         String? @db.Uuid

  // Stage 1: Yandex Market. price_uzs stays the VITALO price (applied in the Mini App at once).
  yandex_price_uzs             BigInt? // seen by admin, manager, marketer
  yandex_commission_percent    Decimal?  @db.Decimal(5, 2) // admin only (costs.view)
  yandex_payment_fee_percent   Decimal?  @db.Decimal(5, 2) // «поручение на перевод платежа», admin only
  yandex_logistics_uzs         BigInt? // fixed logistics per order, admin only
  yandex_price_sync_needed     Boolean   @default(false) // the price was changed here but not on Yandex Market yet
  yandex_price_sync_changed_at DateTime?

  // Stage 2B: physical units. unit_tracking is set when the opening balance session is completed; after that the
  // old quantity operations (receipt, write-off, adjustment, return) are closed for the product.
  unit_tracking        Boolean @default(false)
  label_composition_ru String? // short composition for the 75×120 label (not the full one from the card)
  label_composition_uz String?

  // 2.3: product card. Course days = pack_count / servings_per_day (calculated, not stored).
  substance_form_ru        String? // «Цитрат + B6» — shown under the short name
  substance_form_uz        String?
  pack_count               Int? // capsules / tablets / servings in the pack
  servings_per_day         Int?
  std_bioavailability      Boolean @default(false) // «Стандарт VITALO» badges
  std_tested               Boolean @default(false)
  std_original             Boolean @default(false)
  halal_vege               String? // halal | vege | halal_vege | none | unknown (D-32)
  shell_ru                 String? // «Оболочка: …» fact line
  shell_uz                 String?
  halal_vege_source        String? // admin only: label, maker's site, certificate
  /// 6а-В (D-62): manual promo label on the card and the tile — eleven_eleven | black_friday | hit | new; null = none
  promo_label              String?
  market_advantage_percent Int? // «На X% выгоднее Маркета», 0–50 (D-10)
  doctor_verdict_ru        String?
  doctor_verdict_uz        String?
  intake_memo_ru           String? // not shown to customers until release 3
  intake_memo_uz           String?
  admin_note               String? // staff comment, e.g. «сверить при следующей поставке»

  // Payme: fiscal receipt data (the tax office). ИКПУ (MXIK, 17 digits) and the package code from tasnif.soliq.uz
  ikpu_code    String?
  package_code String?

  // Генплан, этап 5 (D-57, docs/plans/IHERB_PLAN.md): iHerb. markup / auto pricing / rounding / stock mode — admin only.
  iherb_url             String?
  iherb_product_id      String?  @unique // the number at the end of the iHerb link, e.g. 103250
  cross_border_eligible Boolean  @default(false) // D-60, no longer read (D-61: on_zero_supplier_id decides)
  /// D-61: «если на складе ноль — под заказ у этого поставщика»; null = «Нет в наличии»
  on_zero_supplier_id   String?  @db.Uuid
  auto_pricing_enabled  Boolean  @default(false)
  markup_percent        Int      @default(80)
  price_round_to        Int      @default(1000) // round the auto price up to this many sum
  stock_price_mode      String   @default("freeze") // freeze | dynamic: what auto pricing does while the product is in stock
  // «1-в-1» match with competitors: brand + match_form + dose per capsule/serving + pack_count
  dose_amount           Decimal? @db.Decimal(12, 3)
  dose_unit             String? // mg | mcg | iu | g | ml | cfu_bn
  dose_per              String? // capsule | tablet | softgel | serving | drop
  match_form            String? // normalized chemical form, e.g. «цитрат», «бисглицинат», «D3 холекальциферол»

  brand_entry        brands?        @relation(fields: [brand_id], references: [id])
  manufacturer_entry manufacturers? @relation(fields: [manufacturer_id], references: [id])
  country_entry      countries?     @relation(fields: [country_id], references: [id])
  form_entry         forms?         @relation(fields: [form_id], references: [id])

  categories              product_categories[]
  media                   product_media[]
  relations               product_relations[]       @relation("RelMain")
  related_to              product_relations[]       @relation("RelOther")
  inventory               inventory[]
  batches                 inventory_batches[]
  movements               inventory_movements[]
  cart_items              cart_items[]
  order_items             order_items[]
  purchase_lines          purchase_lines[]
  physical_units          physical_units[]
  marketplace_order_lines marketplace_order_lines[]
  sku_aliases             product_sku_aliases[]
  receiving_lines         receiving_session_lines[]
  favorites               favorites[]
  promo_targets           promotion_targets[]
  block_items             content_block_items[]
  waitlist                product_waitlist[]
  substances              product_substances[]
  iherb_snapshots         iherb_price_snapshots[]
  suppliers               product_suppliers[]
  on_zero_supplier        suppliers?                @relation("on_zero_supplier", fields: [on_zero_supplier_id], references: [id])
  price_changes           price_changes[]
  competitor_prices       competitor_prices[]
  admin_ai_memory         admin_business_memory[]
  support_threads         support_threads[]
  reviews                 reviews[]

  /// 3.10-Б: published reviews — their number and the sum of their stars (the average is sum / count)
  reviews_count           Int                       @default(0)
  rating_sum              Int                       @default(0)

  // Trigram index on name/brand/keywords for typo-tolerant search: see constraints.sql
  @@index([status])
  @@index([brand])
  @@index([brand_id])
  @@index([manufacturer_id])
  @@index([country_id])
  @@index([form_id])
}

/// Stage 1 dictionaries: unique name_ru ignoring case and extra spaces (expression index in the migration).
/// Never deleted (trigger), only archived; an archived value is not offered for new choices.
model brands {
  id               String              @id @default(uuid()) @db.Uuid
  name_ru          String
  name_uz          String?
  status           EntityStatus        @default(active)
  is_test          Boolean             @default(false) // аудит 10.11, п. 1.5
  // 2.2: brand showcase and the brand page
  slug             String?             @unique
  logo_url         String?
  country_ru       String?
  country_uz       String?
  why_vitalo_ru    String?
  why_vitalo_uz    String?
  show_in_showcase Boolean             @default(true)
  sort_order       Int                 @default(0)
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt
  products         products[]
  promo_targets    promotion_targets[]
}

model manufacturers {
  id         String       @id @default(uuid()) @db.Uuid
  name_ru    String
  name_uz    String?
  status     EntityStatus @default(active)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  products   products[]
}

model countries {
  id         String       @id @default(uuid()) @db.Uuid
  name_ru    String
  name_uz    String?
  status     EntityStatus @default(active)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  products   products[]
}

model forms {
  id         String       @id @default(uuid()) @db.Uuid
  name_ru    String
  name_uz    String?
  status     EntityStatus @default(active)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  products   products[]
}

// ───────────── PURCHASES (Stage 2A) ─────────────
/// Suppliers (e.g. Glorious Health Nutrition). Unique name ignoring case and spaces; never deleted, only archived.
/// D-61: kind ozon (bought on Ozon, sold from stock) | local | foreign (abroad: prepayment only, «Под заказ {from_ru}»).
/// code: the suppliers the code knows (ozon, iherb). days_* and guarantee_days: the «под заказ» terms from the payment.
model suppliers {
  id             String                 @id @default(uuid()) @db.Uuid
  name           String
  status         EntityStatus           @default(active)
  note           String?
  code           String?                @unique
  kind           String                 @default("local")
  from_ru        String?
  from_uz        String?
  days_min       Int?
  days_max       Int?
  guarantee_days Int?
  sort           Int                    @default(100)
  created_at     DateTime               @default(now())
  updated_at     DateTime               @updatedAt
  purchases      purchases[]
  receiving      receiving_sessions[]
  products       product_suppliers[]
  on_zero_for    products[]             @relation("on_zero_supplier")
  order_items    order_items[]
  batches        cross_border_batches[]
}

/// D-61: where a product is bought (several suppliers possible).
model product_suppliers {
  product_id   String   @db.Uuid
  supplier_id  String   @db.Uuid
  supplier_sku String?
  created_at   DateTime @default(now())

  product  products  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  supplier suppliers @relation(fields: [supplier_id], references: [id])

  @@id([product_id, supplier_id])
  @@index([supplier_id])
}

/// Ozon accounts the goods are bought from. Same rules as suppliers.
model ozon_accounts {
  id         String               @id @default(uuid()) @db.Uuid
  name       String
  status     EntityStatus         @default(active)
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt
  purchases  purchases[]
  receiving  receiving_sessions[]
}

/// A purchase is never deleted. OZON: ozon_account_id + ozon_order_number required (unique pair);
/// SUPPLIER: supplier_id required (CHECK in the migration). Money: whole UZS.
model purchases {
  id                     String             @id @default(uuid()) @db.Uuid
  source_type            PurchaseSourceType
  ozon_account_id        String?            @db.Uuid
  supplier_id            String?            @db.Uuid
  is_test                Boolean            @default(false) // аудит 10.11, п. 1.5: не входит в «вложено в закупки»
  ozon_order_number      String?
  purchase_date          DateTime           @db.Date
  final_actual_total_uzs BigInt? // what was really paid; null = the line prices are used
  status                 PurchaseStatus     @default(EXPECTED)
  comment                String?
  created_by             String?            @db.Uuid
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  ozon_account         ozon_accounts?         @relation(fields: [ozon_account_id], references: [id])
  supplier             suppliers?             @relation(fields: [supplier_id], references: [id])
  staff                staff_users?           @relation(fields: [created_by], references: [id])
  lines                purchase_lines[]
  events               purchase_events[]
  units                physical_units[]
  receiving            receiving_sessions[]
  cross_border_batches cross_border_batches[]

  @@index([source_type, purchase_date])
  @@index([ozon_account_id, ozon_order_number])
  @@index([supplier_id])
}

/// Remaining to receive = max(0, ordered - cancelled - received): computed, never stored.
model purchase_lines {
  id                      String   @id @default(uuid()) @db.Uuid
  purchase_id             String   @db.Uuid
  product_id              String   @db.Uuid
  ordered_qty             Int
  cancelled_qty           Int      @default(0)
  received_qty            Int      @default(0) // may exceed ordered (more arrived than expected)
  unit_price_original_uzs BigInt
  allocated_total_uzs     BigInt? // line total after spreading the final actual total (see purchase-cost.ts)
  position                Int // order of input (1, 2, …): the order of lines everywhere and the rounding tie-break
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  purchase        purchases                 @relation(fields: [purchase_id], references: [id])
  product         products                  @relation(fields: [product_id], references: [id])
  physical_units  physical_units[]
  receiving_lines receiving_session_lines[]

  @@unique([purchase_id, product_id])
  @@unique([purchase_id, position])
  @@index([product_id])
}

// ───────────── PHYSICAL UNITS AND RECEIVING (Stage 2B) ─────────────
/// One physical jar with its own label. physical_id = «V-» + seq with zeros to 6 digits (V-000184); seq comes from
/// the Postgres sequence physical_unit_seq (gaps after a rollback are fine, a number is never reused).
/// Never deleted (trigger); physical_id and seq never change (trigger).
model physical_units {
  id                   String             @id @default(uuid()) @db.Uuid
  physical_id          String             @unique
  seq                  Int                @unique
  product_id           String             @db.Uuid
  purchase_id          String?            @db.Uuid
  purchase_line_id     String?            @db.Uuid
  receiving_session_id String             @db.Uuid
  actual_cost_uzs      BigInt
  expiry_date          DateTime           @db.Date
  status               PhysicalUnitStatus @default(RECEIVED)
  label_print_count    Int                @default(0)
  last_printed_at      DateTime?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  product           products                  @relation(fields: [product_id], references: [id])
  purchase          purchases?                @relation(fields: [purchase_id], references: [id])
  purchase_line     purchase_lines?           @relation(fields: [purchase_line_id], references: [id])
  receiving_session receiving_sessions        @relation(fields: [receiving_session_id], references: [id])
  events            physical_unit_events[]
  marketplace_units marketplace_order_units[]
  order_units       order_item_units[]

  @@index([product_id, status, expiry_date, seq]) // FEFO later: the earliest expiry first
  @@index([status])
  @@index([receiving_session_id])
  @@index([purchase_line_id])
}

/// Append-only history of a unit (a trigger forbids UPDATE and DELETE).
model physical_unit_events {
  id               String              @id @default(uuid()) @db.Uuid
  physical_unit_id String              @db.Uuid
  type             String // CREATED | IN_STOCK | LABEL_PRINTED | VOIDED | COST_CHANGED
  from_status      PhysicalUnitStatus?
  to_status        PhysicalUnitStatus?
  reference_type   String? // receiving_session
  reference_id     String?             @db.Uuid
  note             String?
  created_by       String?             @db.Uuid
  created_at       DateTime            @default(now())

  unit  physical_units @relation(fields: [physical_unit_id], references: [id])
  staff staff_users?   @relation(fields: [created_by], references: [id])

  @@index([physical_unit_id, created_at])
}

/// Stage 2E: Mini App order line <-> physical unit (the same idea as marketplace_order_units, Q5). Reserved by FEFO
/// when the payment is confirmed; picked_at = Physical ID confirmed at assembly; released_at = taken off the order
/// (cancel, swap, return decision). cost_snapshot_uzs = the cost of the unit when it was handed to delivery (sale).
/// One unit is in at most one active assignment across Mini App AND Yandex orders (index + triggers).
model order_item_units {
  id                String    @id @default(uuid()) @db.Uuid
  order_id          String    @db.Uuid
  order_item_id     String    @db.Uuid
  physical_unit_id  String    @db.Uuid
  assigned_by       String?   @db.Uuid
  assigned_at       DateTime  @default(now())
  picked_at         DateTime?
  fefo_override     String?
  released_at       DateTime?
  release_reason    String?
  return_decision   String?
  cost_snapshot_uzs BigInt?

  order orders         @relation(fields: [order_id], references: [id])
  item  order_items    @relation(fields: [order_item_id], references: [id])
  unit  physical_units @relation(fields: [physical_unit_id], references: [id])

  @@index([order_id])
  @@index([physical_unit_id])
}

// ───────────── STAGE 3: EXPENSES, TAX, PAYROLL (admin only) ─────────────

/// Never deleted when it has expenses: only hidden.
model expense_categories {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique
  hidden     Boolean    @default(false)
  position   Int        @default(0)
  created_at DateTime   @default(now())
  expenses   expenses[]
}

/// Other expenses (packaging, ads, …). Deleted softly with a reason (audit).
model expenses {
  id            String    @id @default(uuid()) @db.Uuid
  spent_on      DateTime  @db.Date
  category_id   String    @db.Uuid
  amount_uzs    BigInt
  comment       String?
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  delete_reason String?

  category expense_categories @relation(fields: [category_id], references: [id])

  @@index([spent_on])
}

/// «Отметить оплаченным» for the turnover tax of a month (YYYY-MM). What was paid never changes afterwards.
model tax_payments {
  month           String   @id // YYYY-MM
  paid_on         DateTime @db.Date
  paid_amount_uzs BigInt
  /// what the system showed when it was marked paid
  turnover_uzs    BigInt
  rate_percent    Decimal  @db.Decimal(5, 2)
  tax_uzs         BigInt
  paid_by         String?  @db.Uuid
  created_at      DateTime @default(now())
}

/// People who get a fixed monthly salary (not necessarily users of the system).
model payroll_employees {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  start_month String // YYYY-MM: the first month a salary is accrued for
  end_month   String? // YYYY-MM: the last month (set when the employee is switched off)
  created_at  DateTime           @default(now())
  rates       payroll_rates[]
  payments    payroll_payments[]
}

/// The monthly amount from a month on; earlier months keep their amount.
model payroll_rates {
  id          String   @id @default(uuid()) @db.Uuid
  employee_id String   @db.Uuid
  from_month  String // YYYY-MM
  amount_uzs  BigInt
  created_at  DateTime @default(now())

  employee payroll_employees @relation(fields: [employee_id], references: [id])

  @@unique([employee_id, from_month])
}

/// «Отметить выплаченной» for one employee and month.
model payroll_payments {
  id          String   @id @default(uuid()) @db.Uuid
  employee_id String   @db.Uuid
  month       String // YYYY-MM
  paid_on     DateTime @db.Date
  amount_uzs  BigInt
  paid_by     String?  @db.Uuid
  created_at  DateTime @default(now())

  employee payroll_employees @relation(fields: [employee_id], references: [id])

  @@unique([employee_id, month])
}

/// A reminder was sent (kind + day): never twice, also after a restart.
/// Генплан, этап 5, iherb-2-prices (D-57): one upload of the iHerb wishlist (pasted page or saved file).
model iherb_uploads {
  id             String                  @id @default(uuid()) @db.Uuid
  staff_user_id  String?                 @db.Uuid
  source         String                  @default("wishlist")
  items_total    Int                     @default(0)
  items_matched  Int                     @default(0)
  prices_changed Int                     @default(0)
  created_at     DateTime                @default(now())
  staff          staff_users?            @relation(fields: [staff_user_id], references: [id], onDelete: SetNull)
  snapshots      iherb_price_snapshots[]
  price_changes  price_changes[]

  @@index([created_at])
}

/// PriceHistory: an iHerb price at one moment; product_id is null while no VITALO product has this iHerb number.
model iherb_price_snapshots {
  id               String        @id @default(uuid()) @db.Uuid
  upload_id        String        @db.Uuid
  product_id       String?       @db.Uuid
  iherb_product_id String
  title            String?
  price_uzs        BigInt
  list_price_uzs   BigInt?
  in_stock         Boolean       @default(true)
  bestseller       Boolean       @default(false)
  bestseller_rank  Int? // place in the iHerb best-seller list, when the page / table shows it
  weight_kg        Decimal?      @db.Decimal(8, 3)
  source           String        @default("wishlist")
  taken_at         DateTime      @default(now())
  upload           iherb_uploads @relation(fields: [upload_id], references: [id], onDelete: Restrict)
  product          products?     @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([iherb_product_id, taken_at], map: "iherb_price_snapshots_iherb_taken_idx")
  @@index([product_id, taken_at], map: "iherb_price_snapshots_product_taken_idx")
  @@index([upload_id], map: "iherb_price_snapshots_upload_idx")
}

/// Auto price log (D-57): applied | skipped (skip_reason: in_stock_freeze | iherb_out_of_stock | no_change).
model price_changes {
  id              String         @id @default(uuid()) @db.Uuid
  product_id      String         @db.Uuid
  upload_id       String?        @db.Uuid
  staff_user_id   String?        @db.Uuid
  reason          String         @default("iherb_auto")
  status          String
  skip_reason     String?
  old_price_uzs   BigInt
  new_price_uzs   BigInt
  iherb_price_uzs BigInt?
  markup_percent  Int?
  floor_applied   Boolean        @default(false)
  big_jump        Boolean        @default(false)
  yandex_check    Boolean        @default(false)
  created_at      DateTime       @default(now())
  product         products       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  upload          iherb_uploads? @relation(fields: [upload_id], references: [id], onDelete: SetNull)
  staff           staff_users?   @relation(fields: [staff_user_id], references: [id], onDelete: SetNull)

  @@index([product_id, created_at], map: "price_changes_product_created_idx")
  @@index([created_at], map: "price_changes_created_idx")
}

/// Генплан, этап 5, iherb-4-competitors (D-57): a competitor price with the strict «1-в-1» match (brand, form, dose, pack).
model competitor_prices {
  id               String       @id @default(uuid()) @db.Uuid
  product_id       String       @db.Uuid
  platform         String // uzum | yandex_market | pharmacy | social | other
  seller           String?
  title            String?
  url              String?
  price_uzs        BigInt
  observed_on      DateTime     @db.Date
  brand            String?
  match_form       String?
  dose_amount      Decimal?     @db.Decimal(12, 3)
  dose_unit        String?
  dose_per         String?
  pack_count       Int?
  orders_count     Int? // how many orders / sales the competitor shows (Uzum «N заказов»)
  match_status     String // match | mismatch | incomplete
  mismatch_reasons Json         @default("[]")
  source           String       @default("manual") // manual | ai
  staff_user_id    String?      @db.Uuid
  hidden_at        DateTime?
  created_at       DateTime     @default(now())
  product          products     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  staff            staff_users? @relation(fields: [staff_user_id], references: [id], onDelete: SetNull)

  @@index([product_id, observed_on], map: "competitor_prices_product_observed_idx")
}

/// AI analyst (D-57, node 5): what the owner pasted («Что я прислал») and what the model read from it.
model admin_ai_feed {
  id            String                  @id @default(uuid()) @db.Uuid
  staff_user_id String?                 @db.Uuid
  raw_text      String
  status        String                  @default("parsed") // parsed | saved | failed
  rows          Json                    @default("[]") // what the model read, checked by our code («1-в-1»)
  saved         Json? // { competitor_prices, facts }
  error_code    String?
  request_id    String?                 @db.Uuid
  created_at    DateTime                @default(now())
  saved_at      DateTime?
  staff         staff_users?            @relation(fields: [staff_user_id], references: [id], onDelete: SetNull)
  facts         admin_business_memory[]

  @@index([created_at], map: "admin_ai_feed_created_idx")
}

/// AI analyst long memory («Память о бизнесе»): one fact per row; never deleted, «Убрать» sets active = false.
model admin_business_memory {
  id            String         @id @default(uuid()) @db.Uuid
  kind          String // competitor_price | orders | bestseller_rank | decision | note
  product_id    String?        @db.Uuid
  platform      String?
  seller        String?
  value_num     Decimal?       @db.Decimal(18, 2)
  value_text    String?
  observed_on   DateTime       @db.Date
  source        String         @default("feed") // feed | manual
  feed_id       String?        @db.Uuid
  staff_user_id String?        @db.Uuid
  active        Boolean        @default(true)
  created_at    DateTime       @default(now())
  product       products?      @relation(fields: [product_id], references: [id], onDelete: SetNull)
  feed          admin_ai_feed? @relation(fields: [feed_id], references: [id], onDelete: SetNull)
  staff         staff_users?   @relation(fields: [staff_user_id], references: [id], onDelete: SetNull)

  @@index([active, observed_on], map: "admin_business_memory_active_idx")
  @@index([product_id], map: "admin_business_memory_product_idx")
}

/// AI analyst request log («Журнал запросов»): every call to the model, its tokens and cost (the monthly budget).
model admin_ai_requests {
  id                 String       @id @default(uuid()) @db.Uuid
  staff_user_id      String?      @db.Uuid
  scenario           String // feed | chat
  model              String
  question           String?
  answer             String?
  input_tokens       Int          @default(0)
  output_tokens      Int          @default(0)
  cache_read_tokens  Int          @default(0)
  cache_write_tokens Int          @default(0)
  cost_usd           Decimal      @default(0) @db.Decimal(12, 6)
  outcome            String // ok | refusal | max_tokens | not_json | error
  error_code         String?
  latency_ms         Int          @default(0)
  created_at         DateTime     @default(now())
  staff              staff_users? @relation(fields: [staff_user_id], references: [id], onDelete: SetNull)

  @@index([created_at], map: "admin_ai_requests_created_idx")
}

/// A 09/15/21 reminder slot that was already sent.
model iherb_reminders {
  slot       DateTime @id
  created_at DateTime @default(now())
}

model finance_reminders {
  id      String   @id @default(uuid()) @db.Uuid
  kind    String // before_due | due_day
  day     DateTime @db.Date
  sent_at DateTime @default(now())

  @@unique([kind, day])
}

// ───────────── STAGE 2C: MARKETPLACE (YANDEX) ORDERS ─────────────

enum Marketplace {
  yandex

  @@map("marketplace")
}

/// NEW -> ASSEMBLED -> HANDED_TO_DELIVERY -> DELIVERED; CANCELLED (before the handover) and RETURNED (after it).
enum MarketplaceOrderStatus {
  NEW
  ASSEMBLED
  HANDED_TO_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED

  @@map("marketplace_order_status")
}

/// A Yandex Market order, separate from the VITALO orders table (Q3). Unique per (marketplace, external number).
/// Never deleted (trigger). Status changes are written to audit_logs with the employee and the time.
model marketplace_orders {
  id                    String                 @id @default(uuid()) @db.Uuid
  marketplace           Marketplace            @default(yandex)
  external_number       String
  order_date            DateTime               @db.Date
  customer_name         String?
  status                MarketplaceOrderStatus @default(NEW)
  commission_percent    Decimal                @default(18.5) @db.Decimal(5, 2) // admin only (costs.view)
  note                  String?
  cancel_reason         String?
  created_by            String?                @db.Uuid
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  assembled_at          DateTime?
  handed_at             DateTime?
  delivered_at          DateTime?
  closed_at             DateTime? // cancelled or returned
  /// Stage 2D: manual (typed in the admin panel) or yandex_api (created by the sync)
  source                String                 @default("manual")
  /// Created by the sync without units: not enough stock («Не хватает остатка»), «Зарезервировать банки» later
  stock_shortage        Boolean                @default(false)
  /// Stage 2D: Yandex side, shown only; our statuses are moved by employees (except a Yandex cancellation)
  yandex_status         String?
  yandex_substatus      String?
  yandex_campaign_id    BigInt?
  yandex_updated_at     DateTime?
  /// «Отгрузить до» from Yandex (delivery.shipment): the date and, when given, the time HH:MM. Null when Yandex sent none
  ship_by_date          DateTime?              @db.Date
  ship_by_time          String?
  /// Stage 3: a test order (admin) — excluded from analytics, tax and summaries
  is_test               Boolean                @default(false)
  /// Stage 3: what the delivery really cost US (we bring it to the pickup point), admin only
  own_delivery_cost_uzs BigInt                 @default(0)

  staff    staff_users?                  @relation(fields: [created_by], references: [id])
  lines    marketplace_order_lines[]
  units    marketplace_order_units[]
  external marketplace_external_orders[]

  @@unique([marketplace, external_number])
  @@index([status, order_date])
}

model marketplace_order_lines {
  id             String   @id @default(uuid()) @db.Uuid
  order_id       String   @db.Uuid
  product_id     String   @db.Uuid
  position       Int
  qty            Int
  unit_price_uzs BigInt // sale price per unit on Yandex
  created_at     DateTime @default(now())

  order   marketplace_orders        @relation(fields: [order_id], references: [id])
  product products                  @relation(fields: [product_id], references: [id])
  units   marketplace_order_units[]

  @@unique([order_id, position])
  @@index([product_id])
}

/// Q5: order line <-> physical unit. Reserved (FEFO) when the order is created; picked_at = Physical ID confirmed
/// at assembly; released_at = taken off the order (cancel, swap). One unit is in at most one active assignment:
/// partial unique index in the migration.
model marketplace_order_units {
  id                String    @id @default(uuid()) @db.Uuid
  order_id          String    @db.Uuid
  line_id           String    @db.Uuid
  physical_unit_id  String    @db.Uuid
  assigned_by       String?   @db.Uuid
  assigned_at       DateTime  @default(now())
  picked_at         DateTime?
  fefo_override     String? // reason when not the earliest expiry was chosen
  released_at       DateTime?
  release_reason    String?
  return_decision   String? // ACCEPTED | WRITTEN_OFF (after RETURNED)
  /// Stage 3: the cost of the unit when it was handed to delivery (sale), like order_item_units
  cost_snapshot_uzs BigInt?

  order marketplace_orders      @relation(fields: [order_id], references: [id])
  line  marketplace_order_lines @relation(fields: [line_id], references: [id])
  unit  physical_units          @relation(fields: [physical_unit_id], references: [id])

  @@index([order_id])
  @@index([physical_unit_id])
}

/// Alternative SKUs of a product (old codes): the Yandex sync and the product search find the product by them
/// when the SKU itself does not match. Unique for the whole catalog ignoring case (alias_norm = upper(trim)),
/// and never equal to the SKU of another product (triggers in the migration).
model product_sku_aliases {
  id         String   @id @default(uuid()) @db.Uuid
  product_id String   @db.Uuid
  alias      String
  alias_norm String   @unique
  /// yandex: an old SKU on Yandex Market; internal: our old SKU (TPRD-…)
  source     String
  created_by String?  @db.Uuid
  created_at DateTime @default(now())

  product products @relation(fields: [product_id], references: [id])

  @@index([product_id])
}

/// Stage 2D: one Yandex order as seen by the sync (read only). Unique per (marketplace, external number), so a
/// repeated poll or notification never creates a second order. Keeps the last raw answer of Yandex (no token
/// is ever stored), the link to our order and the «Требует внимания» state with its closing.
model marketplace_external_orders {
  id                    String      @id @default(uuid()) @db.Uuid
  marketplace           Marketplace @default(yandex)
  external_number       String
  campaign_id           BigInt
  status                String
  substatus             String?
  yandex_updated_at     DateTime?
  raw                   Json
  order_id              String?     @db.Uuid
  /// UNKNOWN_SKU | NOT_UNIT_TRACKED | NOT_ENOUGH_STOCK | FIRST_SEEN_LATE | RETURN | UNKNOWN_STATUS | BAD_DATA | CURRENCY
  attention_kind        String?
  attention_reason      String?
  attention_at          DateTime?
  attention_notified_at DateTime?
  new_order_notified_at DateTime?
  /// «Закрыть как неактуальный» (admin): never raised again by later polls
  closed_at             DateTime?
  closed_by             String?     @db.Uuid
  close_reason          String?
  last_error            String?
  first_seen_at         DateTime    @default(now())
  last_seen_at          DateTime    @default(now())

  order marketplace_orders? @relation(fields: [order_id], references: [id])

  @@unique([marketplace, external_number])
  @@index([attention_at])
}

/// Stage 2D: one sync run (schedule, «Проверить сейчас» or a notification). details: what was done or, in
/// DRY_RUN, what would be done, per order.
model yandex_sync_runs {
  id          String    @id @default(uuid()) @db.Uuid
  trigger     String // schedule | manual | webhook
  mode        String // DRY_RUN | LIVE
  started_at  DateTime  @default(now())
  finished_at DateTime?
  found       Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  attention   Int       @default(0)
  errors      Int       @default(0)
  error       String?
  details     Json?
  started_by  String?   @db.Uuid

  @@index([started_at])
}

/// One receiving: PURCHASE (by Ozon account or supplier) or OPENING_BALANCE (the stock count sheet).
/// At most one OPEN session per source and one OPEN opening balance: partial unique indexes in the migration.
model receiving_sessions {
  id              String                 @id @default(uuid()) @db.Uuid
  type            ReceivingSessionType
  purchase_id     String?                @db.Uuid
  ozon_account_id String?                @db.Uuid
  supplier_id     String?                @db.Uuid
  status          ReceivingSessionStatus @default(OPEN)
  created_by      String?                @db.Uuid
  created_at      DateTime               @default(now())
  completed_at    DateTime?
  completion_key  String?                @unique

  purchase     purchases?                @relation(fields: [purchase_id], references: [id])
  ozon_account ozon_accounts?            @relation(fields: [ozon_account_id], references: [id])
  supplier     suppliers?                @relation(fields: [supplier_id], references: [id])
  staff        staff_users?              @relation(fields: [created_by], references: [id])
  lines        receiving_session_lines[]
  units        physical_units[]

  @@index([status, created_at])
}

/// What was accepted in a session: per purchase line (or per product for the opening balance).
model receiving_session_lines {
  id                 String   @id @default(uuid()) @db.Uuid
  session_id         String   @db.Uuid
  product_id         String   @db.Uuid
  purchase_line_id   String?  @db.Uuid
  qty                Int
  expiry_date_groups Json // [{ "expiry": "YYYY-MM-DD", "qty": n }]
  discrepancy_qty    Int? // accepted above what was still expected
  created_at         DateTime @default(now())

  session       receiving_sessions @relation(fields: [session_id], references: [id])
  product       products           @relation(fields: [product_id], references: [id])
  purchase_line purchase_lines?    @relation(fields: [purchase_line_id], references: [id])

  @@index([session_id])
  @@index([purchase_line_id])
}

/// Append-only history of a purchase (a trigger forbids UPDATE and DELETE).
model purchase_events {
  id               String   @id @default(uuid()) @db.Uuid
  purchase_id      String   @db.Uuid
  purchase_line_id String?  @db.Uuid // no foreign key on purpose: a removed line keeps its history
  type             String // CREATED | EDITED | FINAL_TOTAL_SET | LINE_ADDED | LINE_EDITED | LINE_REMOVED | CANCELLED | RECALCULATED
  qty              Int?
  before_json      Json?
  after_json       Json?
  note             String?
  created_by       String?  @db.Uuid
  created_at       DateTime @default(now())

  purchase purchases    @relation(fields: [purchase_id], references: [id])
  staff    staff_users? @relation(fields: [created_by], references: [id])

  @@index([purchase_id, created_at])
}

model product_categories {
  product_id  String     @db.Uuid
  category_id String     @db.Uuid
  product     products   @relation(fields: [product_id], references: [id])
  category    categories @relation(fields: [category_id], references: [id])

  @@id([product_id, category_id])
}

model product_media {
  id             String    @id @default(uuid()) @db.Uuid
  product_id     String    @db.Uuid
  media_type     MediaType
  url            String
  sort_order     Int       @default(0)
  is_main        Boolean   @default(false)
  title          String?
  // Optimized versions (D2): url = main WebP up to 1200 px, thumb = 400 px; JPEG fallbacks; size of the main one
  url_jpeg       String?
  thumb_url      String?
  thumb_url_jpeg String?
  width          Int?
  height         Int?
  product        products  @relation(fields: [product_id], references: [id])

  @@index([product_id])
}

model product_relations {
  id                 String       @id @default(uuid()) @db.Uuid
  product_id         String       @db.Uuid
  related_product_id String       @db.Uuid
  relation_type      RelationType
  sort_order         Int          @default(0)
  product            products     @relation("RelMain", fields: [product_id], references: [id])
  related            products     @relation("RelOther", fields: [related_product_id], references: [id])

  @@unique([product_id, related_product_id, relation_type])
}

// ───────────── INVENTORY ─────────────
model warehouses {
  id        String                @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  status    EntityStatus          @default(active)
  inventory inventory[]
  batches   inventory_batches[]
  movements inventory_movements[]
}

model inventory {
  id           String     @id @default(uuid()) @db.Uuid
  warehouse_id String     @db.Uuid
  product_id   String     @db.Uuid
  actual_qty   Int        @default(0)
  reserved_qty Int        @default(0)
  // available_qty = actual_qty - reserved_qty (computed, never stored)
  updated_at   DateTime   @updatedAt
  warehouse    warehouses @relation(fields: [warehouse_id], references: [id])
  product      products   @relation(fields: [product_id], references: [id])

  // CHECK (reserved_qty >= 0 AND actual_qty >= 0 AND reserved_qty <= actual_qty): constraints.sql
  @@unique([product_id, warehouse_id])
}

model inventory_batches {
  id           String     @id @default(uuid()) @db.Uuid
  warehouse_id String     @db.Uuid
  product_id   String     @db.Uuid
  batch_no     String?
  qty          Int
  cost_uzs     BigInt?
  received_at  DateTime   @default(now())
  expiry_date  DateTime?  @db.Date
  warehouse    warehouses @relation(fields: [warehouse_id], references: [id])
  product      products   @relation(fields: [product_id], references: [id])

  @@index([product_id, warehouse_id])
}

model inventory_movements {
  id             String       @id @default(uuid()) @db.Uuid
  warehouse_id   String       @db.Uuid
  product_id     String       @db.Uuid
  movement_type  MovementType
  qty            Int
  reference_type String?
  reference_id   String?      @db.Uuid
  reason         String?
  created_by     String?      @db.Uuid
  created_at     DateTime     @default(now())
  warehouse      warehouses   @relation(fields: [warehouse_id], references: [id])
  product        products     @relation(fields: [product_id], references: [id])
  staff          staff_users? @relation(fields: [created_by], references: [id])

  @@index([product_id, created_at])
  @@index([reference_type, reference_id])
}

// ───────────── CART / ORDERS ─────────────
model carts {
  id         String       @id @default(uuid()) @db.Uuid
  user_id    String       @db.Uuid
  status     CartStatus   @default(active)
  /// 3.3: the promo code typed in the cart (checked again on every cart read; removed when it stops fitting)
  promo_code String?
  /// 3.10-А: «Списать бонусы» is on (the amount is computed on every read)
  use_bonus  Boolean      @default(false)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  user       users        @relation(fields: [user_id], references: [id])
  items      cart_items[]

  // one active cart per user: partial unique index in constraints.sql
  @@index([user_id, status])
}

model cart_items {
  id                      String   @id @default(uuid()) @db.Uuid
  cart_id                 String   @db.Uuid
  product_id              String   @db.Uuid
  qty                     Int
  unit_price_snapshot_uzs BigInt
  /// 3.7: the sale the snapshot price came from: «Акция завершилась» when it is over
  campaign_id             String?  @db.Uuid
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  cart                    carts    @relation(fields: [cart_id], references: [id])
  product                 products @relation(fields: [product_id], references: [id])

  @@unique([cart_id, product_id])
}

model shipments {
  id         String   @id @default(uuid()) @db.Uuid
  note       String?
  created_at DateTime @default(now())
  orders     orders[]
}

model order_number_counters {
  day  DateTime @id @db.Date
  last Int      @default(0) // VTL-YYYYMMDD-NNNN, incremented atomically
}

model orders {
  id                             String        @id @default(uuid()) @db.Uuid
  order_number                   String        @unique
  user_id                        String        @db.Uuid
  status                         OrderStatus   @default(new)
  payment_status                 PaymentStatus @default(payment_pending)
  shipment_id                    String?       @db.Uuid
  recipient_name                 String
  recipient_phone                String
  region_id                      String        @db.Uuid
  city_id                        String        @db.Uuid
  address_text                   String
  latitude                       Decimal?      @db.Decimal(9, 6)
  longitude                      Decimal?      @db.Decimal(9, 6)
  customer_comment               String?
  delivery_method                String
  delivery_cost_uzs              BigInt
  goods_total_uzs                BigInt // before discounts
  discount_total_uzs             BigInt        @default(0)
  bonus_used_uzs                 BigInt        @default(0)
  goods_paid_uzs                 BigInt // goods after discounts, minus bonuses = real money part of goods
  total_uzs                      BigInt // money to pay = goods_paid + delivery
  promo_id                       String?       @db.Uuid
  bonus_rate_snapshot            Decimal?      @db.Decimal(6, 4)
  created_at                     DateTime      @default(now())
  paid_at                        DateTime?
  reserved_until                 DateTime?
  payment_reminder_sent_at       DateTime? // D3: "ждёт оплаты" reminder sent (once per order)
  payment_check_reminder_sent_at DateTime? // Stage 0.2: "payment not checked for N hours" sent to admins/managers (once per order)
  delivered_at                   DateTime?
  cancelled_at                   DateTime?
  /// Stage 2E: paid, but the units of unit-tracked lines could not be reserved (reason). «Нужно внимание склада»
  units_attention                String?
  /// Waybill number of the delivery service (BTS, Yandex Go…): optional, typed by the warehouse or the admin, printed on the label
  delivery_waybill               String?
  /// Stage 3: a test order (admin) — excluded from analytics, tax and summaries
  is_test                        Boolean       @default(false)
  /// Stage 3: what the delivery really cost US (free delivery for the customer), admin only
  own_delivery_cost_uzs          BigInt        @default(0)
  /// 3.3: the promo code (normalized) and the frozen price calculation; never recalculated after creation
  promo_code                     String?
  pricing_json                   Json?
  /// D-60: the promised delivery window of an order with lines from the USA (moved by staff with a reason)
  expected_from                  DateTime?     @db.Date
  expected_to                    DateTime?     @db.Date
  /// D-60: the staff reminder «дата прошла» was sent for this expected_to
  cross_border_overdue_for       DateTime?     @db.Date
  /// 3.10-Б: the bot asked «Как вам …? Оставьте отзыв» (once per order, 3 days after the delivery)
  review_asked_at                DateTime?

  user                users                  @relation(fields: [user_id], references: [id])
  region              regions                @relation(fields: [region_id], references: [id])
  city                cities                 @relation(fields: [city_id], references: [id])
  promo               promotions?            @relation(fields: [promo_id], references: [id])
  shipment            shipments?             @relation(fields: [shipment_id], references: [id])
  items               order_items[]
  item_units          order_item_units[]
  history             order_status_history[]
  edits               order_edit_log[]
  payments            payments[]
  returns             returns[]
  promo_usages        promotion_usages[]
  ledger              bonus_ledger[]
  cancel_requests     cancel_requests[]
  tasks               manager_tasks[]
  notifications       notifications[]
  receipts            payment_receipts[]
  payme_txs           payme_transactions[]
  cross_border_events cross_border_events[]
  support_threads     support_threads[]
  reviews             reviews[]

  @@index([user_id, status, created_at])
  @@index([status, reserved_until]) // reservation-expiry job
}

model order_items {
  id                    String                @id @default(uuid()) @db.Uuid
  order_id              String                @db.Uuid
  product_id            String                @db.Uuid
  sku_snapshot          String
  name_ru_snapshot      String
  qty                   Int
  unit_price_uzs        BigInt
  line_total_uzs        BigInt
  discount_uzs          BigInt                @default(0)
  paid_line_total_uzs   BigInt // actual paid price of line (basis for returns)
  /// D-60: local | cross_border («Под заказ из США»: nothing reserved until the jars arrive)
  source                String                @default("local")
  cross_border_batch_id String?               @db.Uuid
  /// D-60: the cross-border line got its jars in Tashkent (from the parcel or from the Tashkent stock)
  arrived_at            DateTime?
  cross_border_batch    cross_border_batches? @relation(fields: [cross_border_batch_id], references: [id])
  /// D-61: the supplier of a «под заказ» line
  supplier_id           String?               @db.Uuid
  supplier              suppliers?            @relation(fields: [supplier_id], references: [id])
  order                 orders                @relation(fields: [order_id], references: [id])
  product               products              @relation(fields: [product_id], references: [id])
  return_items          return_items[]
  units                 order_item_units[]

  @@index([order_id])
}

model order_status_history {
  id              String    @id @default(uuid()) @db.Uuid
  order_id        String    @db.Uuid
  from_status     String?
  to_status       String
  reason          String?
  changed_by_type ActorType
  changed_by_id   String?   @db.Uuid
  created_at      DateTime  @default(now())
  order           orders    @relation(fields: [order_id], references: [id])

  @@index([order_id, created_at])
}

model order_edit_log {
  id            String      @id @default(uuid()) @db.Uuid
  order_id      String      @db.Uuid
  staff_user_id String      @db.Uuid
  before_json   Json
  after_json    Json
  reason        String
  created_at    DateTime    @default(now())
  order         orders      @relation(fields: [order_id], references: [id])
  staff         staff_users @relation(fields: [staff_user_id], references: [id])
}

model cancel_requests {
  id            String              @id @default(uuid()) @db.Uuid
  order_id      String              @db.Uuid
  user_id       String              @db.Uuid
  status        CancelRequestStatus @default(requested)
  reason        String?
  decided_by    String?             @db.Uuid
  reject_reason String? // mandatory when rejected
  created_at    DateTime            @default(now())
  decided_at    DateTime?
  order         orders              @relation(fields: [order_id], references: [id])
  user          users               @relation(fields: [user_id], references: [id])
  staff         staff_users?        @relation(fields: [decided_by], references: [id])
}

// ───────────── PAYMENTS ─────────────
model payment_methods {
  id              String              @id @default(uuid()) @db.Uuid
  code            String              @unique // payme | click | uzum | bank_transfer
  name_ru         String
  name_uz         String?
  status          PaymentMethodStatus @default(enabled)
  timeout_minutes Int
  config_json     Json? // NO plaintext secrets: store refs to env/secret manager
  payments        payments[]
}

model payments {
  id                  String                         @id @default(uuid()) @db.Uuid
  order_id            String                         @db.Uuid
  payment_method_id   String                         @db.Uuid
  amount_uzs          BigInt
  status              PaymentStatus                  @default(payment_pending)
  provider_payment_id String?
  // 2.1, online payments: where the customer is sent to pay, and when that link stops working
  checkout_url        String?
  expires_at          DateTime?
  created_at          DateTime                       @default(now())
  updated_at          DateTime                       @updatedAt
  paid_at             DateTime?
  order               orders                         @relation(fields: [order_id], references: [id])
  method              payment_methods                @relation(fields: [payment_method_id], references: [id])
  attempts            payment_attempts[]
  manual              manual_payment_confirmations[]
  payme_txs           payme_transactions[]

  @@unique([payment_method_id, provider_payment_id]) // webhook duplicate protection
  @@index([order_id, status])
}

/// Payme (Merchant API): one row per Payme transaction. state 1 created, 2 performed, -1 cancelled before the
/// payment, -2 cancelled after it. Times are milliseconds (as Payme sends and expects them).
model payme_transactions {
  id           String    @id @default(uuid()) @db.Uuid
  payme_id     String    @unique
  order_id     String    @db.Uuid
  payment_id   String?   @db.Uuid
  amount_tiyin BigInt
  state        Int
  payme_time   BigInt // `time` from Payme's CreateTransaction (GetStatement filters by it)
  create_time  BigInt
  perform_time BigInt?
  cancel_time  BigInt?
  reason       Int?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt
  order        orders    @relation(fields: [order_id], references: [id])
  payment      payments? @relation(fields: [payment_id], references: [id])

  @@index([order_id, state])
  @@index([payme_time])
}

model payment_attempts {
  id                     String        @id @default(uuid()) @db.Uuid
  payment_id             String        @db.Uuid
  attempt_no             Int
  status                 AttemptStatus @default(pending)
  provider_request_id    String?
  provider_response_json Json?
  created_at             DateTime      @default(now())
  payment                payments      @relation(fields: [payment_id], references: [id])

  @@unique([payment_id, attempt_no])
}

model manual_payment_confirmations {
  id                    String       @id @default(uuid()) @db.Uuid
  payment_id            String       @db.Uuid
  receipt_url           String?
  customer_confirmed_at DateTime?
  verified_by           String?      @db.Uuid
  verified_at           DateTime?
  comment               String?
  payment               payments     @relation(fields: [payment_id], references: [id])
  staff                 staff_users? @relation(fields: [verified_by], references: [id])
}

model manager_tasks {
  id          String       @id @default(uuid()) @db.Uuid
  type        TaskType
  order_id    String?      @db.Uuid
  status      TaskStatus   @default(open)
  note        String?
  assigned_to String?      @db.Uuid
  created_at  DateTime     @default(now())
  done_at     DateTime?
  order       orders?      @relation(fields: [order_id], references: [id])
  staff       staff_users? @relation(fields: [assigned_to], references: [id])

  @@index([status, type])
}

// ───────────── PROMOTIONS ─────────────
model promotions {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  type               PromoType
  value              Decimal             @db.Decimal(12, 2)
  start_at           DateTime
  end_at             DateTime
  min_order_uzs      BigInt?
  max_discount_uzs   BigInt?
  global_limit       Int?
  per_customer_limit Int?
  stacking_mode      StackingMode        @default(exclusive)
  status             PromoStatus         @default(draft)
  scope_type         PromoScope          @default(order)
  // 3.3: promo codes — the customer's text, «только первый заказ», when it was made
  description_ru     String?
  description_uz     String?
  first_order_only   Boolean             @default(false)
  // 3.7: sales («Акции»): titles, look, address, «без даты окончания» (end_at is then far away), «Сообщить о старте»
  kind               PromotionKind       @default(code)
  title_ru           String?
  title_uz           String?
  slug               String?             @unique
  skin               CampaignSkin?
  open_ended         Boolean             @default(false)
  notify_start       Boolean             @default(false)
  start_notified_at  DateTime?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @default(now()) @updatedAt
  targets            promotion_targets[]
  usages             promotion_usages[]
  codes              promo_codes[]
  orders             orders[]

  @@index([kind, status, start_at])
}

model promotion_targets {
  id                 String      @id @default(uuid()) @db.Uuid
  promotion_id       String      @db.Uuid
  product_id         String?     @db.Uuid
  category_id        String?     @db.Uuid
  brand              String?
  /// 3.3: a brand from the brands dictionary (the text column `brand` is not used)
  brand_id           String?     @db.Uuid
  /// 3.7: a sale: the product's discount in % or its sale price (one of the two)
  discount_pct       Int?
  campaign_price_uzs BigInt?
  promotion          promotions  @relation(fields: [promotion_id], references: [id])
  product            products?   @relation(fields: [product_id], references: [id])
  category           categories? @relation(fields: [category_id], references: [id])
  brand_ref          brands?     @relation(fields: [brand_id], references: [id])

  @@index([promotion_id])
  @@index([product_id])
}

model promotion_usages {
  id           String           @id @default(uuid()) @db.Uuid
  promotion_id String           @db.Uuid
  user_id      String           @db.Uuid
  order_id     String           @db.Uuid
  discount_uzs BigInt
  status       PromoUsageStatus @default(reserved)
  created_at   DateTime         @default(now())
  promotion    promotions       @relation(fields: [promotion_id], references: [id])
  user         users            @relation(fields: [user_id], references: [id])
  order        orders           @relation(fields: [order_id], references: [id])

  @@unique([order_id]) // 3.3: one promo code per order
  @@index([promotion_id, user_id])
}

model promo_codes {
  id           String          @id @default(uuid()) @db.Uuid
  promotion_id String          @db.Uuid
  code         String          @unique
  status       PromoCodeStatus @default(active)
  promotion    promotions      @relation(fields: [promotion_id], references: [id])
}

// ───────────── REVIEWS (3.10-Б) ─────────────

/// 3.10-Б: a verified review — only for a product of the customer's delivered order, one per order line product.
/// Never deleted: rejected or hidden reviews stay for the history and the audit.
model reviews {
  id            String         @id @default(uuid()) @db.Uuid
  product_id    String         @db.Uuid
  order_id      String         @db.Uuid
  user_id       String         @db.Uuid
  rating        Int            @db.SmallInt
  /// quick tags chosen by the customer: effect | easy | quality | price | no_effect | hard
  tags          String[]       @default([])
  text          String?
  /// «Саидкомол Х.» when show_name, else «Покупатель VITALO» (the phone and username are never shown)
  show_name     Boolean        @default(true)
  author_name   String
  lang          Lang           @default(ru)
  status        ReviewStatus   @default(pending)
  /// spam | rude | empty | medical | other
  reject_reason String?
  reject_note   String?
  moderated_by  String?        @db.Uuid
  moderated_at  DateTime?
  /// the answer of the VITALO specialist under the review
  reply_text    String?
  replied_by    String?        @db.Uuid
  replied_at    DateTime?
  /// what was posted to the bonus account on publication (0 — none: the programme was off or the amount is 0)
  bonus_uzs     Int            @default(0)
  published_at  DateTime?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  product   products       @relation(fields: [product_id], references: [id])
  order     orders         @relation(fields: [order_id], references: [id])
  user      users          @relation(fields: [user_id], references: [id])
  moderator staff_users?   @relation("ReviewModerator", fields: [moderated_by], references: [id], onDelete: SetNull)
  replier   staff_users?   @relation("ReviewReplier", fields: [replied_by], references: [id], onDelete: SetNull)
  media     review_media[]

  @@unique([order_id, product_id])
  @@index([product_id, status, published_at])
  @@index([status, created_at])
  @@index([user_id, created_at])
}

/// 3.10-Б: up to 2 photos of a review. Until publication they live in the private folder (private_key, like receipts);
/// on publication they are copied to the public uploads (url…).
model review_media {
  id             String   @id @default(uuid()) @db.Uuid
  review_id      String   @db.Uuid
  sort           Int      @default(0) @db.SmallInt
  /// file name base in REVIEWS_DIR: <review_id>/<uuid> (+ .webp / .jpg / -400.webp / -400.jpg)
  private_key    String
  url            String?
  url_jpeg       String?
  thumb_url      String?
  thumb_url_jpeg String?
  width          Int?
  height         Int?
  created_at     DateTime @default(now())

  review reviews @relation(fields: [review_id], references: [id])

  @@index([review_id])
}

// ───────────── BONUSES / REFERRAL ─────────────
model bonus_accounts {
  id          String         @id @default(uuid()) @db.Uuid
  user_id     String         @unique @db.Uuid
  balance_uzs BigInt         @default(0)
  /// 3.10-А: the last accrual (purchase, review, manual +): the balance burns lifetime_days after it
  last_activity_at    DateTime?
  /// 3.10-А: «Через 7 дней сгорят» was sent for this last_activity_at
  expiry_notified_for DateTime?
  updated_at  DateTime       @updatedAt
  user        users          @relation(fields: [user_id], references: [id])
  ledger      bonus_ledger[]
  // CHECK (balance_uzs >= 0): constraints.sql

  @@index([last_activity_at])
}

// Immutable: UPDATE/DELETE blocked by trigger (constraints.sql)
model bonus_ledger {
  id                String         @id @default(uuid()) @db.Uuid
  bonus_account_id  String         @db.Uuid
  operation_type    BonusOp
  amount_uzs        BigInt
  balance_after_uzs BigInt
  order_id          String?        @db.Uuid
  reference_id      String?        @db.Uuid
  idempotency_ref   String?        @unique // e.g. "purchase:<orderId>" -> no double accrual on webhook replay
  reason            String?
  created_by        String?        @db.Uuid
  created_at        DateTime       @default(now())
  account           bonus_accounts @relation(fields: [bonus_account_id], references: [id])
  order             orders?        @relation(fields: [order_id], references: [id])
  staff             staff_users?   @relation(fields: [created_by], references: [id])

  @@index([bonus_account_id, created_at])
  @@index([order_id])
  @@index([created_at])
}

model referrals {
  id              String                  @id @default(uuid()) @db.Uuid
  inviter_user_id String                  @db.Uuid
  referral_code   String                  @unique
  created_at      DateTime                @default(now())
  inviter         users                   @relation(fields: [inviter_user_id], references: [id])
  attributions    referral_attributions[]
}

model referral_attributions {
  id              String         @id @default(uuid()) @db.Uuid
  referral_id     String         @db.Uuid
  invited_user_id String         @unique @db.Uuid // one reward per new user
  first_order_id  String?        @db.Uuid
  status          ReferralStatus @default(pending)
  expires_at      DateTime // registration + 30 days
  referral        referrals      @relation(fields: [referral_id], references: [id])
  invited         users          @relation(fields: [invited_user_id], references: [id])
}

// ───────────── DELIVERY ─────────────
model delivery_tariffs {
  id                          String       @id @default(uuid()) @db.Uuid
  region_id                   String       @db.Uuid
  city_id                     String?      @db.Uuid
  tariff_uzs                  BigInt
  free_shipping_threshold_uzs BigInt
  status                      TariffStatus @default(active)
  min_days                    Int? // delivery term, working days; NULL on a city tariff = take the region one
  max_days                    Int?
  note_ru                     String?
  note_uz                     String?
  is_test                     Boolean      @default(false) // created automatically, "test, check" in the admin
  region                      regions      @relation(fields: [region_id], references: [id])
  city                        cities?      @relation(fields: [city_id], references: [id])

  @@index([region_id, city_id])
}

// ───────────── RETURNS ─────────────
model returns {
  id                String         @id @default(uuid()) @db.Uuid
  order_id          String         @db.Uuid
  user_id           String         @db.Uuid
  status            ReturnStatus   @default(requested)
  reason            ReturnReason
  comment           String? // required when reason = other (app validation)
  reject_reason     String? // required when rejected
  created_at        DateTime       @default(now())
  approved_by       String?        @db.Uuid
  approved_at       DateTime?
  refund_amount_uzs BigInt?
  refunded_at       DateTime?
  refund_comment    String?
  /// 3.10-В: every line with its full quantity — the order itself goes to «Возврат» (units on check, all bonuses back)
  full_order         Boolean   @default(false)
  rejected_by        String?   @db.Uuid
  rejected_at        DateTime?
  refunded_by        String?   @db.Uuid
  /// card | cash | payme | click | other — how the money went back (the refund is manual)
  refund_method      String?
  /// 3.10-В, a part of the order: the cashback taken back and the spent bonuses given back for the returned lines
  bonus_reversed_uzs BigInt    @default(0)
  bonus_returned_uzs BigInt    @default(0)
  order             orders         @relation(fields: [order_id], references: [id])
  user              users          @relation(fields: [user_id], references: [id])
  staff             staff_users?   @relation(fields: [approved_by], references: [id])
  items             return_items[]
  media             return_media[]

  @@index([order_id])
  @@index([status, created_at])
}

model return_items {
  id                String           @id @default(uuid()) @db.Uuid
  return_id         String           @db.Uuid
  order_item_id     String           @db.Uuid
  qty               Int
  refund_amount_uzs BigInt
  condition         ReturnCondition?
  return            returns          @relation(fields: [return_id], references: [id])
  order_item        order_items      @relation(fields: [order_item_id], references: [id])

  @@index([return_id])
}

model return_media {
  id         String   @id @default(uuid()) @db.Uuid
  return_id  String   @db.Uuid
  /// 3.10-В: the private file key (photos of a return are never public; staff open them with their token)
  url        String
  created_at DateTime @default(now())
  return     returns  @relation(fields: [return_id], references: [id])

  @@index([return_id])
}

// ───────────── CONTENT / MARKETING ─────────────
model content_blocks {
  id                String                @id @default(uuid()) @db.Uuid
  type              ContentBlockType
  title_ru          String?
  title_uz          String?
  image_url         String?
  sort_order        Int                   @default(0)
  status            ContentStatus         @default(active)
  start_at          DateTime?
  end_at            DateTime?
  click_target_type ClickTarget?
  click_target_id   String?
  external_url      String?
  items             content_block_items[]
}

model content_block_items {
  id               String         @id @default(uuid()) @db.Uuid
  content_block_id String         @db.Uuid
  product_id       String?        @db.Uuid
  category_id      String?        @db.Uuid
  sort_order       Int            @default(0)
  block            content_blocks @relation(fields: [content_block_id], references: [id])
  product          products?      @relation(fields: [product_id], references: [id])
  category         categories?    @relation(fields: [category_id], references: [id])
}

model favorites {
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  created_at DateTime @default(now())
  user       users    @relation(fields: [user_id], references: [id])
  product    products @relation(fields: [product_id], references: [id])

  @@id([user_id, product_id])
}

/// 2.4: «Сообщить о поступлении». One row per customer and product; notified_at is set when the bot has written
/// «снова в наличии» (then the row is closed; subscribing again after that reopens it).
/// 3.4: «Проверить совместимость у специалиста» — one request per cart composition (D-40).
model compat_requests {
  id                String             @id @default(uuid()) @db.Uuid
  user_id           String             @db.Uuid
  /// product ids of the cart, sorted (quantities and order do not matter)
  product_ids       String[]           @db.Uuid
  /// the sorted ids joined with "," — the same cart composition gives the same key
  set_key           String
  /// [{ product_id, sku, name_ru, name_uz }] at the time of the request
  items             Json
  lang              String // ru | uz — the customer's language, the answer is written in it
  /// may hold health data: only admins and specialists see it; the text is cleared after 90 days (D-40)
  comment           String?
  comment_purged_at DateTime?
  status            String             @default("pending") // pending | answered | closed (the cart changed before an answer)
  source            String             @default("specialist") // specialist | instant (a saved answer for the same set) | ai | ai_cache | ai_fallback (3.8)
  verdict           String? // compatible | spread | consult
  answer_text       String?
  answered_by       String?            @db.Uuid
  answered_at       DateTime?
  saved_answer_id   String?            @db.Uuid
  created_at        DateTime           @default(now())
  user              users              @relation(fields: [user_id], references: [id])
  answerer          staff_users?       @relation(fields: [answered_by], references: [id])
  saved_answer      compat_answers?    @relation(fields: [saved_answer_id], references: [id], onDelete: SetNull)
  /// 3.8: source ai | ai_cache — the VITALO AI answer shown for this request
  ai_answer_id      String?            @db.Uuid
  ai_answer         ai_compat_answers? @relation(fields: [ai_answer_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([status, created_at])
}

/// 3.4: answers a specialist marked «Можно использовать повторно» — by product set and language; switched off, never deleted.
model compat_answers {
  id                String              @id @default(uuid()) @db.Uuid
  set_key           String
  product_ids       String[]            @db.Uuid
  items             Json
  lang              String
  verdict           String
  text              String
  enabled           Boolean             @default(true)
  source_request_id String?             @db.Uuid
  created_by        String?             @db.Uuid
  created_at        DateTime            @default(now())
  updated_at        DateTime            @default(now()) @updatedAt
  /// Шаг 0а-3: VITALO AI gave another label for this set by the current rules — «пересмотреть — правила изменились»;
  /// cleared when the answer is saved again, edited or marked «Ответ верен» (then review_ai_verdict stays: the same AI
  /// label does not mark it again)
  review_needed_at  DateTime?
  /// the AI label at that moment: compatible | spread | consult
  review_ai_verdict String?
  author            staff_users?        @relation(fields: [created_by], references: [id], onDelete: SetNull)
  requests          compat_requests[]
  ai_answers        ai_compat_answers[]

  @@unique([set_key, lang])
}

/// 3.8: «Справочник веществ» for VITALO AI (D-45), edited in «Совместимость → Вещества». Synonyms are lower case
/// («d3», «холекальциферол»); a form points at its substance (P-5-P → B6: B6 rules apply to it); a drug group is
/// only used in «осторожно с лекарствами» rules. Never deleted — switched off.
model substances {
  id         String               @id @default(uuid()) @db.Uuid
  code       String               @unique
  kind       String               @default("substance") // substance | form | drug_group
  name_ru    String
  name_uz    String
  synonyms   String[]
  parent_id  String?              @db.Uuid
  enabled    Boolean              @default(true)
  sort_order Int                  @default(0)
  created_at DateTime             @default(now())
  updated_at DateTime             @default(now()) @updatedAt
  parent     substances?          @relation("SubstanceForms", fields: [parent_id], references: [id], onDelete: SetNull)
  forms      substances[]         @relation("SubstanceForms")
  products   product_substances[]
  rules_a    compat_rules[]       @relation("RuleA")
  rules_b    compat_rules[]       @relation("RuleB")
  /// Шаг 0б: «вещество → цель» (D-69)
  goals      goal_evidence[]
}

/// 3.8: active substances of a product for the compatibility rules (chosen from the dictionary).
model product_substances {
  product_id   String     @db.Uuid
  substance_id String     @db.Uuid
  created_at   DateTime   @default(now())
  product      products   @relation(fields: [product_id], references: [id])
  substance    substances @relation(fields: [substance_id], references: [id])

  @@id([product_id, substance_id])
}

/// 3.8: compatibility rules between two substances. VITALO AI sees only approved ones (an admin approves, D-45).
/// kind: synergy | spread | avoid | drug_caution; when_*: morning | day | evening | with_food | empty_stomach | any.
model compat_rules {
  id             String       @id @default(uuid()) @db.Uuid
  substance_a_id String       @db.Uuid
  substance_b_id String       @db.Uuid
  kind           String
  interval_hours Int?
  when_a         String?
  when_b         String?
  text_ru        String
  text_uz        String
  /// where the rule comes from (study, «комментарий врача»); staff only
  source         String?
  origin         String       @default("admin") // xlsx | vitalo (proposed by VITALO) | admin
  status         String       @default("draft") // draft | approved | off
  approved_by    String?      @db.Uuid
  approved_at    DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @default(now()) @updatedAt
  substance_a    substances   @relation("RuleA", fields: [substance_a_id], references: [id])
  substance_b    substances   @relation("RuleB", fields: [substance_b_id], references: [id])
  approver       staff_users? @relation("RuleApprover", fields: [approved_by], references: [id], onDelete: SetNull)

  @@unique([substance_a_id, substance_b_id])
  @@index([status])
}

/// 3.8: every call to the model — for the budget and «Расход AI». No customer text here (privacy, D-45).
/// status: ok | invalid (the answer failed the checks) | error | timeout
model ai_requests {
  id            String   @id @default(uuid()) @db.Uuid
  scenario      String // cart | chat
  user_id       String?  @db.Uuid
  set_key       String?
  lang          String
  model         String
  status        String
  input_tokens  Int      @default(0)
  output_tokens Int      @default(0)
  cost_usd      Decimal  @default(0) @db.Decimal(12, 6)
  latency_ms    Int?
  /// why it failed: a check name or an error code, never the customer's text
  error         String?
  /// аудит 4.5: the model's answer that a check rejected (staff only, for the log of refusals)
  rejected_text String?
  created_at    DateTime @default(now())

  @@index([created_at])
  @@index([user_id, scenario, created_at])
}

/// D-70: a conversation of a customer with VITALO AI about the cart. number — AI-ГГГГММДД-NNNN (Tashkent date). The text
/// lives 12 months (settings «VITALO AI»), then it is wiped and the numbers stay; the customer may delete it at once.
/// Staff: «VITALO AI → Переписки» — the admin and the specialist; every opening is in the audit log.
model ai_chats {
  id          String            @id @default(uuid()) @db.Uuid
  number      String            @unique
  user_id     String            @db.Uuid
  lang        String
  /// the cart when the conversation started: [{product_id, sku, name}]
  cart        Json              @default("[]")
  empty_cart  Boolean           @default(false)
  /// sleep | stress | energy | joints | immunity | sport | compat | other — of the latest answer
  topic       String?
  /// answered | clarify | off_topic | red_flag | failed | limit — of the latest message
  outcome     String?
  questions   Int               @default(0)
  cost_usd    Decimal           @default(0) @db.Decimal(12, 6)
  model       String?
  /// the specialist's mark: ok | wrong
  review      String?
  review_note String?
  reviewed_by String?           @db.Uuid
  reviewed_at DateTime?
  /// the customer deleted it: the texts are wiped at once
  deleted_at  DateTime?
  /// the texts were wiped after the retention period
  purged_at   DateTime?
  created_at  DateTime          @default(now())
  updated_at  DateTime          @default(now()) @updatedAt
  user        users             @relation(fields: [user_id], references: [id])
  reviewer    staff_users?      @relation("AiChatReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)
  messages    ai_chat_messages[]

  @@index([created_at])
  @@index([user_id, created_at])
}

/// D-70: a message of a conversation. text — the customer's question (phones and e-mails cut out) or the AI answer;
/// payload — the AI answer as the app shows it (products, tips, follow-up questions, clarifying options).
model ai_chat_messages {
  id            String    @id @default(uuid()) @db.Uuid
  chat_id       String    @db.Uuid
  /// user | ai
  role          String
  /// question | answer | clarify | off_topic | red_flag | failed
  kind          String
  text          String?
  payload       Json?
  model         String?
  input_tokens  Int       @default(0)
  output_tokens Int       @default(0)
  cost_usd      Decimal   @default(0) @db.Decimal(12, 6)
  latency_ms    Int?
  /// why the answer was not shown: a check name or an error code
  error         String?
  created_at    DateTime  @default(now())
  chat          ai_chats  @relation(fields: [chat_id], references: [id])

  @@index([chat_id, created_at])
}

/// 3.8: VITALO AI answers of the cart, cached by product set (no quantities, no order) and language. A new answer is
/// shown at once and waits in «Совместимость → AI-ответы»; red (consult) ones first (D-45).
/// review: new | approved (saved as a specialist answer) | fixed (corrected into one) | hidden (not used any more)
model ai_compat_answers {
  id              String            @id @default(uuid()) @db.Uuid
  set_key         String
  product_ids     String[]          @db.Uuid
  items           Json
  lang            String
  verdict         String // compatible | spread | consult
  text            String
  /// [{ product_id, when }] — in the language of the answer
  timing          Json?
  /// one product in the cart: 2–3 products in stock that go well with it
  suggested_ids   String[]          @db.Uuid
  model           String
  ai_request_id   String?           @db.Uuid
  review          String            @default("new")
  reviewed_by     String?           @db.Uuid
  reviewed_at     DateTime?
  saved_answer_id String?           @db.Uuid
  used_count      Int               @default(0)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @default(now()) @updatedAt
  reviewer        staff_users?      @relation(fields: [reviewed_by], references: [id], onDelete: SetNull)
  saved_answer    compat_answers?   @relation(fields: [saved_answer_id], references: [id], onDelete: SetNull)
  requests        compat_requests[]

  @@index([set_key, lang])
  @@index([review, created_at])
}

model product_waitlist {
  id           String    @id @default(uuid()) @db.Uuid
  product_id   String    @db.Uuid
  user_id      String    @db.Uuid
  phone        String? // from the profile at the moment of subscribing, if there was one
  created_at   DateTime  @default(now())
  notified_at  DateTime?
  /// 2.4 patch: the customer switched the bell off; the row stays (never deleted), subscribing again clears it
  cancelled_at DateTime?
  product      products  @relation(fields: [product_id], references: [id])
  user         users     @relation(fields: [user_id], references: [id])

  @@unique([product_id, user_id])
  @@index([notified_at])
}

/// 3.1: a receipt (screenshot or PDF) the customer sent to the bot for a card transfer. Never deleted: a rejected one
/// stays with its reason. The file lives in the private receipts folder (RECEIPTS_DIR), not in the public uploads.
model payment_receipts {
  id                      String       @id @default(uuid()) @db.Uuid
  order_id                String       @db.Uuid
  user_id                 String       @db.Uuid
  file_key                String // path inside RECEIPTS_DIR: <order id>/<receipt id>.<ext>
  mime                    String
  size_bytes              Int
  /// Telegram's id of the file: the same picture sent twice for one order is stored once
  telegram_file_unique_id String
  /// Telegram's file id for this bot: staff get the receipt from the bot without uploading it again
  telegram_file_id        String
  status                  String       @default("pending") // pending | confirmed | rejected
  reject_reason           String?
  reviewed_by             String?      @db.Uuid
  reviewed_at             DateTime?
  created_at              DateTime     @default(now())
  order                   orders       @relation(fields: [order_id], references: [id])
  user                    users        @relation(fields: [user_id], references: [id])
  reviewer                staff_users? @relation(fields: [reviewed_by], references: [id])

  @@unique([order_id, telegram_file_unique_id])
  @@index([order_id, created_at])
}

model marketing_campaigns {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  segment_type    SegmentType
  text_ru         String
  text_uz         String?
  image_url       String?
  button_text     String         @default("Открыть магазин")
  status          CampaignStatus @default(draft)
  recipient_count Int?
  sent_count      Int?
  delivered_count Int?
  error_count     Int?
  created_by      String         @db.Uuid
  created_at      DateTime       @default(now())
  staff           staff_users    @relation(fields: [created_by], references: [id])
}

model notifications {
  id              String       @id @default(uuid()) @db.Uuid
  user_id         String?      @db.Uuid // customer recipient, or
  staff_user_id   String?      @db.Uuid // employee recipient
  chat_id         BigInt // Telegram chat = Telegram user id of the recipient
  kind            String // service (always sent) | marketing (only with users.marketing_opt_in)
  template        String // e.g. order.paid, staff.new_order (see notification-templates.ts)
  payload         Json? // template variables + lang
  status          String       @default("queued") // queued | sending | sent | failed | skipped
  attempts        Int          @default(0)
  next_attempt_at DateTime     @default(now())
  error           String?
  created_at      DateTime     @default(now())
  sent_at         DateTime?
  /// 3.2: the order / product the message is about (admin history, Mini App centre)
  order_id        String?      @db.Uuid
  product_id      String?      @db.Uuid
  /// 3.2: section of the Mini App notification centre: order | waitlist | promo | bonus (bonus: release 4, hidden). null = bot only
  category        String?
  /// 3.2: one message per event, e.g. "order:<id>:paid"; a repeated event is skipped (ON CONFLICT DO NOTHING)
  dedup_key       String?      @unique
  /// 3.2: the customer opened it in the centre (or «Прочитать все»)
  read_at         DateTime?
  user            users?       @relation(fields: [user_id], references: [id])
  staff           staff_users? @relation(fields: [staff_user_id], references: [id])
  order           orders?      @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([status, next_attempt_at])
  @@index([order_id, created_at])
}

// ───────────── LEGAL / AUDIT / TECH ─────────────
model legal_documents {
