// VITALO — Prisma schema (Stage 1). Based on Appendix 1 (ER).
// Money = BigInt UZS. Timestamps = UTC. Field names follow the ER document (snake_case).
//
// Deviations from Appendix 1 (to be confirmed, see README "Решения по ТЗ"):
//  - orders.delivery_status removed: duplicated orders.status (handed/in_transit/delivered).
//  - added shipments (merging orders into one physical delivery, Master TZ §11).
//  - added settings, cancel_requests, manager_tasks, notifications, order_number_counters,
//    marketing_recipients, return_media, bank_transfer_details (needed by TZ, absent in ER).
//  - inventory.available_qty is NOT stored: available = actual_qty - reserved_qty (DB view/computed).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent]
}

// ───────────── ENUMS ─────────────
enum UserStatus {
  active
  blocked
  deleting
  deleted
}

enum Lang {
  ru
  uz
}

enum EntityStatus {
  active
  archived
}

enum StaffRole {
  admin
  manager
  warehouse
  marketer
}

enum StaffStatus {
  active
  blocked
}

enum TreeType {
  need
  product_type
}

enum ProductStatus {
  active
  archived
  hidden
}

enum MediaType {
  image
  document
}

enum RelationType {
  similar
  also_bought
}

enum MovementType {
  receipt
  reserve
  release
  deduct
  writeoff
  return_to_stock
  adjustment
}

enum CartStatus {
  active
  converted
  abandoned
}

enum OrderStatus {
  new
  awaiting_payment
  paid
  picking
  handed_to_delivery
  in_transit
  delivered
  cancelled
  return
}

enum PaymentStatus {
  payment_pending
  payment_success
  payment_failed
  payment_cancelled
}

enum AttemptStatus {
  pending
  success
  failed
  cancelled
}

enum PaymentMethodStatus {
  enabled
  disabled
}

enum PromoType {
  percent
  fixed
}

enum StackingMode {
  compatible
  exclusive
}

enum PromoStatus {
  draft
  active
  disabled
  expired
}

enum PromoScope {
  order
  product
  category
  brand
}

enum PromoUsageStatus {
  reserved
  consumed
  rolled_back
}

enum PromoCodeStatus {
  active
  disabled
}

enum BonusOp {
  purchase
  referral
  promo
  manual_add
  manual_subtract
  redemption
  reversal
}

enum ReferralStatus {
  pending
  qualified
  rejected
}

enum TariffStatus {
  active
  disabled
}

enum ReturnStatus {
  requested
  approved
  rejected
  refunded
  closed
}

enum ReturnReason {
  damaged
  wrong_item
  not_as_described
  unsuitable
  changed_mind
  other
}

enum ReturnCondition {
  resellable
  damaged
  opened
  other
}

enum ContentBlockType {
  hero
  promotion
  popular
  categories
  special_offers
  new_arrivals
}

enum ClickTarget {
  product
  category
  promotion
  collection
  external_url
}

enum ContentStatus {
  active
  disabled
}

enum SegmentType {
  all
  new
  one_time
  repeat
  inactive
  bonus_holders
  promo_users
  referral_participants
}

enum CampaignStatus {
  draft
  previewed
  sending
  completed
  cancelled
}

enum LegalStatus {
  draft
  active
  archived
}

enum ActorType {
  system
  staff
  customer
}

enum CancelRequestStatus {
  requested
  approved
  rejected
}

enum TaskStatus {
  open
  in_progress
  done
}

enum TaskType {
  payment_check
  bank_transfer_check
  refund
  other
}

/// Stage 2A: where a purchase comes from.
enum PurchaseSourceType {
  OZON
  SUPPLIER
}

/// Stage 2A: only two statuses; «отменена полностью» is computed from the lines, not stored.
enum PurchaseStatus {
  EXPECTED
  RECEIVED
}

/// Stage 2B: life of one physical jar. 2B uses RECEIVED, IN_STOCK, VOIDED; the rest are for the next stages.
enum PhysicalUnitStatus {
  RECEIVED
  IN_STOCK
  ASSIGNED
  YANDEX_DELIVERY
  YANDEX_SOLD
  VITALO_DELIVERY
  VITALO_SOLD
  RETURNED
  MISSING
  WRITTEN_OFF
  VOIDED

  @@map("physical_unit_status")
}

/// Stage 2B: receiving by purchase (Ozon account / supplier) or the opening balance (stock count sheet).
enum ReceivingSessionType {
  PURCHASE
  OPENING_BALANCE

  @@map("receiving_session_type")
}

enum ReceivingSessionStatus {
  OPEN
  COMPLETED
  CANCELLED

  @@map("receiving_session_status")
}

// ───────────── IDENTITY ─────────────
model users {
  id               String     @id @default(uuid()) @db.Uuid
  telegram_user_id BigInt     @unique
  status           UserStatus @default(active)
  first_name       String
  last_name        String?
  username         String?
  phone            String?
  language         Lang       @default(ru)
  marketing_opt_in Boolean    @default(true)
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  deleted_at       DateTime?

  sessions          user_sessions[]
  addresses         addresses[]
  carts             carts[]
  orders            orders[]
  favorites         favorites[]
  bonus_account     bonus_accounts?
  referrals         referrals[]
  referral_attr     referral_attributions?
  analytics_events  analytics_events[]
  returns           returns[]
  legal_acceptances legal_acceptances[]
  promotion_usages  promotion_usages[]
  notifications     notifications[]
  cancel_requests   cancel_requests[]

  @@index([status])
}

model user_sessions {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique
  device_info String?
  created_at  DateTime  @default(now())
  expires_at  DateTime
  revoked_at  DateTime?
  user        users     @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model regions {
  id        String             @id @default(uuid()) @db.Uuid
  name_ru   String
  name_uz   String
  status    EntityStatus       @default(active)
  cities    cities[]
  addresses addresses[]
  orders    orders[]
  tariffs   delivery_tariffs[]
}

model cities {
  id        String             @id @default(uuid()) @db.Uuid
  region_id String             @db.Uuid
  name_ru   String
  name_uz   String
  status    EntityStatus       @default(active)
  region    regions            @relation(fields: [region_id], references: [id])
  addresses addresses[]
  orders    orders[]
  tariffs   delivery_tariffs[]

  @@index([region_id])
}

model addresses {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  label        String?
  region_id    String    @db.Uuid
  city_id      String    @db.Uuid
  address_text String
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  is_primary   Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  user         users     @relation(fields: [user_id], references: [id])
  region       regions   @relation(fields: [region_id], references: [id])
  city         cities    @relation(fields: [city_id], references: [id])

  // one primary per user: partial unique index in raw SQL (constraints.sql)
  @@index([user_id])
}

model staff_users {
  id               String      @id @default(uuid()) @db.Uuid
  telegram_user_id BigInt      @unique
  name             String
  role             StaffRole
  status           StaffStatus @default(active)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  sessions           staff_sessions[]
  audit_logs         audit_logs[]
  order_edits        order_edit_log[]
  movements          inventory_movements[]
  campaigns          marketing_campaigns[]
  ledger             bonus_ledger[]
  returns_approved   returns[]
  manual_payments    manual_payment_confirmations[]
  tasks              manager_tasks[]
  cancel_decisions   cancel_requests[]
  notifications      notifications[]
  purchases          purchases[]
  purchase_events    purchase_events[]
  receiving          receiving_sessions[]
  unit_events        physical_unit_events[]
  marketplace_orders marketplace_orders[]
}

model staff_sessions {
  id            String      @id @default(uuid()) @db.Uuid
  staff_user_id String      @db.Uuid
  token_hash    String      @unique
  created_at    DateTime    @default(now())
  expires_at    DateTime
  revoked_at    DateTime?
  staff_user    staff_users @relation(fields: [staff_user_id], references: [id])

  @@index([staff_user_id])
}

// ───────────── CATALOG ─────────────
model categories {
  id             String                @id @default(uuid()) @db.Uuid
  parent_id      String?               @db.Uuid
  tree_type      TreeType
  name_ru        String
  name_uz        String
  slug           String                @unique
  sort_order     Int                   @default(0)
  status         EntityStatus          @default(active)
  /// 2.2: a hidden old category points to the one that replaced it (old links and banners keep working)
  merged_into_id String?               @db.Uuid
  parent         categories?           @relation("CatTree", fields: [parent_id], references: [id])
  children       categories[]          @relation("CatTree")
  merged_into    categories?           @relation("CatMerge", fields: [merged_into_id], references: [id])
  merged_from    categories[]          @relation("CatMerge")
  products       product_categories[]
  promo_targets  promotion_targets[]
  block_items    content_block_items[]

  @@index([parent_id, tree_type])
}

model products {
  id                   String        @id @default(uuid()) @db.Uuid
  sku                  String        @unique
  name_ru              String
  name_uz              String?
  // 2.1: optional short name for the cart, checkout, orders and messages; the full name stays on the card and in search
  short_name_ru        String?
  short_name_uz        String?
  brand                String
  manufacturer         String
  country              String?
  form                 String?
  price_uzs            BigInt
  old_price_uzs        BigInt?
  cost_uzs             BigInt?
  min_stock            Int           @default(0)
  status               ProductStatus @default(active)
  short_name_ru        String?
  short_name_uz        String?
  short_description_ru String?
  short_description_uz String?
  composition_ru       String?
  composition_uz       String?
  nutrition_ru         String?
  nutrition_uz         String?
  directions_ru        String?
  directions_uz        String?
  warnings_ru          String?
  warnings_uz          String?
  search_keywords      String?
  popularity_30d       Int           @default(0) // recalculated daily (30-day sold units)
  shipping_weight_g    Int?
  shipping_length_mm   Int?
  shipping_width_mm    Int?
  shipping_height_mm   Int?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  // Stage 1: dictionaries. The text columns brand / manufacturer / country / form stay and keep feeding the
  // Mini App; when a dictionary value is chosen, its name is copied into them (and on rename).
  brand_id        String? @db.Uuid
  manufacturer_id String? @db.Uuid
  country_id      String? @db.Uuid
  form_id         String? @db.Uuid

  // Stage 1: Yandex Market. price_uzs stays the VITALO price (applied in the Mini App at once).
  yandex_price_uzs             BigInt? // seen by admin, manager, marketer
  yandex_commission_percent    Decimal?  @db.Decimal(5, 2) // admin only (costs.view)
  yandex_payment_fee_percent   Decimal?  @db.Decimal(5, 2) // «поручение на перевод платежа», admin only
  yandex_logistics_uzs         BigInt? // fixed logistics per order, admin only
  yandex_price_sync_needed     Boolean   @default(false) // the price was changed here but not on Yandex Market yet
  yandex_price_sync_changed_at DateTime?

  // Stage 2B: physical units. unit_tracking is set when the opening balance session is completed; after that the
  // old quantity operations (receipt, write-off, adjustment, return) are closed for the product.
  unit_tracking        Boolean @default(false)
  label_composition_ru String? // short composition for the 75×120 label (not the full one from the card)
  label_composition_uz String?

  brand_entry        brands?        @relation(fields: [brand_id], references: [id])
  manufacturer_entry manufacturers? @relation(fields: [manufacturer_id], references: [id])
  country_entry      countries?     @relation(fields: [country_id], references: [id])
  form_entry         forms?         @relation(fields: [form_id], references: [id])

  categories              product_categories[]
  media                   product_media[]
  relations               product_relations[]       @relation("RelMain")
  related_to              product_relations[]       @relation("RelOther")
  inventory               inventory[]
  batches                 inventory_batches[]
  movements               inventory_movements[]
  cart_items              cart_items[]
  order_items             order_items[]
  purchase_lines          purchase_lines[]
  physical_units          physical_units[]
  marketplace_order_lines marketplace_order_lines[]
  sku_aliases             product_sku_aliases[]
  receiving_lines         receiving_session_lines[]
  favorites               favorites[]
  promo_targets           promotion_targets[]
  block_items             content_block_items[]

  // Trigram index on name/brand/keywords for typo-tolerant search: see constraints.sql
  @@index([status])
  @@index([brand])
  @@index([brand_id])
  @@index([manufacturer_id])
  @@index([country_id])
  @@index([form_id])
}

/// Stage 1 dictionaries: unique name_ru ignoring case and extra spaces (expression index in the migration).
/// Never deleted (trigger), only archived; an archived value is not offered for new choices.
model brands {
  id               String       @id @default(uuid()) @db.Uuid
  name_ru          String
  name_uz          String?
  status           EntityStatus @default(active)
  // 2.2: brand showcase and the brand page
  slug             String?      @unique
  logo_url         String?
  country_ru       String?
  country_uz       String?
  why_vitalo_ru    String?
  why_vitalo_uz    String?
  show_in_showcase Boolean      @default(true)
  sort_order       Int          @default(0)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  products         products[]
}

model manufacturers {
  id         String       @id @default(uuid()) @db.Uuid
  name_ru    String
  name_uz    String?
  status     EntityStatus @default(active)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  products   products[]
}

model countries {
  id         String       @id @default(uuid()) @db.Uuid
  name_ru    String
  name_uz    String?
  status     EntityStatus @default(active)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  products   products[]
}

model forms {
  id         String       @id @default(uuid()) @db.Uuid
  name_ru    String
  name_uz    String?
  status     EntityStatus @default(active)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  products   products[]
}

// ───────────── PURCHASES (Stage 2A) ─────────────
/// Suppliers (e.g. Glorious Health Nutrition). Unique name ignoring case and spaces; never deleted, only archived.
model suppliers {
  id         String               @id @default(uuid()) @db.Uuid
  name       String
  status     EntityStatus         @default(active)
  note       String?
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt
  purchases  purchases[]
  receiving  receiving_sessions[]
}

/// Ozon accounts the goods are bought from. Same rules as suppliers.
model ozon_accounts {
  id         String               @id @default(uuid()) @db.Uuid
  name       String
  status     EntityStatus         @default(active)
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt
  purchases  purchases[]
  receiving  receiving_sessions[]
}

/// A purchase is never deleted. OZON: ozon_account_id + ozon_order_number required (unique pair);
/// SUPPLIER: supplier_id required (CHECK in the migration). Money: whole UZS.
model purchases {
  id                     String             @id @default(uuid()) @db.Uuid
  source_type            PurchaseSourceType
  ozon_account_id        String?            @db.Uuid
  supplier_id            String?            @db.Uuid
  ozon_order_number      String?
  purchase_date          DateTime           @db.Date
  final_actual_total_uzs BigInt? // what was really paid; null = the line prices are used
  status                 PurchaseStatus     @default(EXPECTED)
  comment                String?
  created_by             String?            @db.Uuid
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  ozon_account ozon_accounts?       @relation(fields: [ozon_account_id], references: [id])
  supplier     suppliers?           @relation(fields: [supplier_id], references: [id])
  staff        staff_users?         @relation(fields: [created_by], references: [id])
  lines        purchase_lines[]
  events       purchase_events[]
  units        physical_units[]
  receiving    receiving_sessions[]

  @@index([source_type, purchase_date])
  @@index([ozon_account_id, ozon_order_number])
  @@index([supplier_id])
}

/// Remaining to receive = max(0, ordered - cancelled - received): computed, never stored.
model purchase_lines {
  id                      String   @id @default(uuid()) @db.Uuid
  purchase_id             String   @db.Uuid
  product_id              String   @db.Uuid
  ordered_qty             Int
  cancelled_qty           Int      @default(0)
  received_qty            Int      @default(0) // may exceed ordered (more arrived than expected)
  unit_price_original_uzs BigInt
  allocated_total_uzs     BigInt? // line total after spreading the final actual total (see purchase-cost.ts)
  position                Int // order of input (1, 2, …): the order of lines everywhere and the rounding tie-break
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  purchase        purchases                 @relation(fields: [purchase_id], references: [id])
  product         products                  @relation(fields: [product_id], references: [id])
  physical_units  physical_units[]
  receiving_lines receiving_session_lines[]

  @@unique([purchase_id, product_id])
  @@unique([purchase_id, position])
  @@index([product_id])
}

// ───────────── PHYSICAL UNITS AND RECEIVING (Stage 2B) ─────────────
/// One physical jar with its own label. physical_id = «V-» + seq with zeros to 6 digits (V-000184); seq comes from
/// the Postgres sequence physical_unit_seq (gaps after a rollback are fine, a number is never reused).
/// Never deleted (trigger); physical_id and seq never change (trigger).
model physical_units {
  id                   String             @id @default(uuid()) @db.Uuid
  physical_id          String             @unique
  seq                  Int                @unique
  product_id           String             @db.Uuid
  purchase_id          String?            @db.Uuid
  purchase_line_id     String?            @db.Uuid
  receiving_session_id String             @db.Uuid
  actual_cost_uzs      BigInt
  expiry_date          DateTime           @db.Date
  status               PhysicalUnitStatus @default(RECEIVED)
  label_print_count    Int                @default(0)
  last_printed_at      DateTime?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  product           products                  @relation(fields: [product_id], references: [id])
  purchase          purchases?                @relation(fields: [purchase_id], references: [id])
  purchase_line     purchase_lines?           @relation(fields: [purchase_line_id], references: [id])
  receiving_session receiving_sessions        @relation(fields: [receiving_session_id], references: [id])
  events            physical_unit_events[]
  marketplace_units marketplace_order_units[]
  order_units       order_item_units[]

  @@index([product_id, status, expiry_date, seq]) // FEFO later: the earliest expiry first
  @@index([status])
  @@index([receiving_session_id])
  @@index([purchase_line_id])
}

/// Append-only history of a unit (a trigger forbids UPDATE and DELETE).
model physical_unit_events {
  id               String              @id @default(uuid()) @db.Uuid
  physical_unit_id String              @db.Uuid
  type             String // CREATED | IN_STOCK | LABEL_PRINTED | VOIDED | COST_CHANGED
  from_status      PhysicalUnitStatus?
  to_status        PhysicalUnitStatus?
  reference_type   String? // receiving_session
  reference_id     String?             @db.Uuid
  note             String?
  created_by       String?             @db.Uuid
  created_at       DateTime            @default(now())

  unit  physical_units @relation(fields: [physical_unit_id], references: [id])
  staff staff_users?   @relation(fields: [created_by], references: [id])

  @@index([physical_unit_id, created_at])
}

/// Stage 2E: Mini App order line <-> physical unit (the same idea as marketplace_order_units, Q5). Reserved by FEFO
/// when the payment is confirmed; picked_at = Physical ID confirmed at assembly; released_at = taken off the order
/// (cancel, swap, return decision). cost_snapshot_uzs = the cost of the unit when it was handed to delivery (sale).
/// One unit is in at most one active assignment across Mini App AND Yandex orders (index + triggers).
model order_item_units {
  id                String    @id @default(uuid()) @db.Uuid
  order_id          String    @db.Uuid
  order_item_id     String    @db.Uuid
  physical_unit_id  String    @db.Uuid
  assigned_by       String?   @db.Uuid
  assigned_at       DateTime  @default(now())
  picked_at         DateTime?
  fefo_override     String?
  released_at       DateTime?
  release_reason    String?
  return_decision   String?
  cost_snapshot_uzs BigInt?

  order orders         @relation(fields: [order_id], references: [id])
  item  order_items    @relation(fields: [order_item_id], references: [id])
  unit  physical_units @relation(fields: [physical_unit_id], references: [id])

  @@index([order_id])
  @@index([physical_unit_id])
}

// ───────────── STAGE 3: EXPENSES, TAX, PAYROLL (admin only) ─────────────

/// Never deleted when it has expenses: only hidden.
model expense_categories {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique
  hidden     Boolean    @default(false)
  position   Int        @default(0)
  created_at DateTime   @default(now())
  expenses   expenses[]
}

/// Other expenses (packaging, ads, …). Deleted softly with a reason (audit).
model expenses {
  id            String    @id @default(uuid()) @db.Uuid
  spent_on      DateTime  @db.Date
  category_id   String    @db.Uuid
  amount_uzs    BigInt
  comment       String?
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  delete_reason String?

  category expense_categories @relation(fields: [category_id], references: [id])

  @@index([spent_on])
}

/// «Отметить оплаченным» for the turnover tax of a month (YYYY-MM). What was paid never changes afterwards.
model tax_payments {
  month           String   @id // YYYY-MM
  paid_on         DateTime @db.Date
  paid_amount_uzs BigInt
  /// what the system showed when it was marked paid
  turnover_uzs    BigInt
  rate_percent    Decimal  @db.Decimal(5, 2)
  tax_uzs         BigInt
  paid_by         String?  @db.Uuid
  created_at      DateTime @default(now())
}

/// People who get a fixed monthly salary (not necessarily users of the system).
model payroll_employees {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  start_month String // YYYY-MM: the first month a salary is accrued for
  end_month   String? // YYYY-MM: the last month (set when the employee is switched off)
  created_at  DateTime           @default(now())
  rates       payroll_rates[]
  payments    payroll_payments[]
}

/// The monthly amount from a month on; earlier months keep their amount.
model payroll_rates {
  id          String   @id @default(uuid()) @db.Uuid
  employee_id String   @db.Uuid
  from_month  String // YYYY-MM
  amount_uzs  BigInt
  created_at  DateTime @default(now())

  employee payroll_employees @relation(fields: [employee_id], references: [id])

  @@unique([employee_id, from_month])
}

/// «Отметить выплаченной» for one employee and month.
model payroll_payments {
  id          String   @id @default(uuid()) @db.Uuid
  employee_id String   @db.Uuid
  month       String // YYYY-MM
  paid_on     DateTime @db.Date
  amount_uzs  BigInt
  paid_by     String?  @db.Uuid
  created_at  DateTime @default(now())

  employee payroll_employees @relation(fields: [employee_id], references: [id])

  @@unique([employee_id, month])
}

/// A reminder was sent (kind + day): never twice, also after a restart.
model finance_reminders {
  id      String   @id @default(uuid()) @db.Uuid
  kind    String // before_due | due_day
  day     DateTime @db.Date
  sent_at DateTime @default(now())

  @@unique([kind, day])
}

// ───────────── STAGE 2C: MARKETPLACE (YANDEX) ORDERS ─────────────

enum Marketplace {
  yandex

  @@map("marketplace")
}

/// NEW -> ASSEMBLED -> HANDED_TO_DELIVERY -> DELIVERED; CANCELLED (before the handover) and RETURNED (after it).
enum MarketplaceOrderStatus {
  NEW
  ASSEMBLED
  HANDED_TO_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED

  @@map("marketplace_order_status")
}

/// A Yandex Market order, separate from the VITALO orders table (Q3). Unique per (marketplace, external number).
/// Never deleted (trigger). Status changes are written to audit_logs with the employee and the time.
model marketplace_orders {
  id                    String                 @id @default(uuid()) @db.Uuid
  marketplace           Marketplace            @default(yandex)
  external_number       String
  order_date            DateTime               @db.Date
  customer_name         String?
  status                MarketplaceOrderStatus @default(NEW)
  commission_percent    Decimal                @default(18.5) @db.Decimal(5, 2) // admin only (costs.view)
  note                  String?
  cancel_reason         String?
  created_by            String?                @db.Uuid
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  assembled_at          DateTime?
  handed_at             DateTime?
  delivered_at          DateTime?
  closed_at             DateTime? // cancelled or returned
  /// Stage 2D: manual (typed in the admin panel) or yandex_api (created by the sync)
  source                String                 @default("manual")
  /// Created by the sync without units: not enough stock («Не хватает остатка»), «Зарезервировать банки» later
  stock_shortage        Boolean                @default(false)
  /// Stage 2D: Yandex side, shown only; our statuses are moved by employees (except a Yandex cancellation)
  yandex_status         String?
  yandex_substatus      String?
  yandex_campaign_id    BigInt?
  yandex_updated_at     DateTime?
  /// «Отгрузить до» from Yandex (delivery.shipment): the date and, when given, the time HH:MM. Null when Yandex sent none
  ship_by_date          DateTime?              @db.Date
  ship_by_time          String?
  /// Stage 3: a test order (admin) — excluded from analytics, tax and summaries
  is_test               Boolean                @default(false)
  /// Stage 3: what the delivery really cost US (we bring it to the pickup point), admin only
  own_delivery_cost_uzs BigInt                 @default(0)

  staff    staff_users?                  @relation(fields: [created_by], references: [id])
  lines    marketplace_order_lines[]
  units    marketplace_order_units[]
  external marketplace_external_orders[]

  @@unique([marketplace, external_number])
  @@index([status, order_date])
}

model marketplace_order_lines {
  id             String   @id @default(uuid()) @db.Uuid
  order_id       String   @db.Uuid
  product_id     String   @db.Uuid
  position       Int
  qty            Int
  unit_price_uzs BigInt // sale price per unit on Yandex
  created_at     DateTime @default(now())

  order   marketplace_orders        @relation(fields: [order_id], references: [id])
  product products                  @relation(fields: [product_id], references: [id])
  units   marketplace_order_units[]

  @@unique([order_id, position])
  @@index([product_id])
}

/// Q5: order line <-> physical unit. Reserved (FEFO) when the order is created; picked_at = Physical ID confirmed
/// at assembly; released_at = taken off the order (cancel, swap). One unit is in at most one active assignment:
/// partial unique index in the migration.
model marketplace_order_units {
  id                String    @id @default(uuid()) @db.Uuid
  order_id          String    @db.Uuid
  line_id           String    @db.Uuid
  physical_unit_id  String    @db.Uuid
  assigned_by       String?   @db.Uuid
  assigned_at       DateTime  @default(now())
  picked_at         DateTime?
  fefo_override     String? // reason when not the earliest expiry was chosen
  released_at       DateTime?
  release_reason    String?
  return_decision   String? // ACCEPTED | WRITTEN_OFF (after RETURNED)
  /// Stage 3: the cost of the unit when it was handed to delivery (sale), like order_item_units
  cost_snapshot_uzs BigInt?

  order marketplace_orders      @relation(fields: [order_id], references: [id])
  line  marketplace_order_lines @relation(fields: [line_id], references: [id])
  unit  physical_units          @relation(fields: [physical_unit_id], references: [id])

  @@index([order_id])
  @@index([physical_unit_id])
}

/// Alternative SKUs of a product (old codes): the Yandex sync and the product search find the product by them
/// when the SKU itself does not match. Unique for the whole catalog ignoring case (alias_norm = upper(trim)),
/// and never equal to the SKU of another product (triggers in the migration).
model product_sku_aliases {
  id         String   @id @default(uuid()) @db.Uuid
  product_id String   @db.Uuid
  alias      String
  alias_norm String   @unique
  /// yandex: an old SKU on Yandex Market; internal: our old SKU (TPRD-…)
  source     String
  created_by String?  @db.Uuid
  created_at DateTime @default(now())

  product products @relation(fields: [product_id], references: [id])

  @@index([product_id])
}

/// Stage 2D: one Yandex order as seen by the sync (read only). Unique per (marketplace, external number), so a
/// repeated poll or notification never creates a second order. Keeps the last raw answer of Yandex (no token
/// is ever stored), the link to our order and the «Требует внимания» state with its closing.
model marketplace_external_orders {
  id                    String      @id @default(uuid()) @db.Uuid
  marketplace           Marketplace @default(yandex)
  external_number       String
  campaign_id           BigInt
  status                String
  substatus             String?
  yandex_updated_at     DateTime?
  raw                   Json
  order_id              String?     @db.Uuid
  /// UNKNOWN_SKU | NOT_UNIT_TRACKED | NOT_ENOUGH_STOCK | FIRST_SEEN_LATE | RETURN | UNKNOWN_STATUS | BAD_DATA | CURRENCY
  attention_kind        String?
  attention_reason      String?
  attention_at          DateTime?
  attention_notified_at DateTime?
  new_order_notified_at DateTime?
  /// «Закрыть как неактуальный» (admin): never raised again by later polls
  closed_at             DateTime?
  closed_by             String?     @db.Uuid
  close_reason          String?
  last_error            String?
  first_seen_at         DateTime    @default(now())
  last_seen_at          DateTime    @default(now())

  order marketplace_orders? @relation(fields: [order_id], references: [id])

  @@unique([marketplace, external_number])
  @@index([attention_at])
}

/// Stage 2D: one sync run (schedule, «Проверить сейчас» or a notification). details: what was done or, in
/// DRY_RUN, what would be done, per order.
model yandex_sync_runs {
  id          String    @id @default(uuid()) @db.Uuid
  trigger     String // schedule | manual | webhook
  mode        String // DRY_RUN | LIVE
  started_at  DateTime  @default(now())
  finished_at DateTime?
  found       Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  attention   Int       @default(0)
  errors      Int       @default(0)
  error       String?
  details     Json?
  started_by  String?   @db.Uuid

  @@index([started_at])
}

/// One receiving: PURCHASE (by Ozon account or supplier) or OPENING_BALANCE (the stock count sheet).
/// At most one OPEN session per source and one OPEN opening balance: partial unique indexes in the migration.
model receiving_sessions {
  id              String                 @id @default(uuid()) @db.Uuid
  type            ReceivingSessionType
  purchase_id     String?                @db.Uuid
  ozon_account_id String?                @db.Uuid
  supplier_id     String?                @db.Uuid
  status          ReceivingSessionStatus @default(OPEN)
  created_by      String?                @db.Uuid
  created_at      DateTime               @default(now())
  completed_at    DateTime?
  completion_key  String?                @unique

  purchase     purchases?                @relation(fields: [purchase_id], references: [id])
  ozon_account ozon_accounts?            @relation(fields: [ozon_account_id], references: [id])
  supplier     suppliers?                @relation(fields: [supplier_id], references: [id])
  staff        staff_users?              @relation(fields: [created_by], references: [id])
  lines        receiving_session_lines[]
  units        physical_units[]

  @@index([status, created_at])
}

/// What was accepted in a session: per purchase line (or per product for the opening balance).
model receiving_session_lines {
  id                 String   @id @default(uuid()) @db.Uuid
  session_id         String   @db.Uuid
  product_id         String   @db.Uuid
  purchase_line_id   String?  @db.Uuid
  qty                Int
  expiry_date_groups Json // [{ "expiry": "YYYY-MM-DD", "qty": n }]
  discrepancy_qty    Int? // accepted above what was still expected
  created_at         DateTime @default(now())

  session       receiving_sessions @relation(fields: [session_id], references: [id])
  product       products           @relation(fields: [product_id], references: [id])
  purchase_line purchase_lines?    @relation(fields: [purchase_line_id], references: [id])

  @@index([session_id])
  @@index([purchase_line_id])
}

/// Append-only history of a purchase (a trigger forbids UPDATE and DELETE).
model purchase_events {
  id               String   @id @default(uuid()) @db.Uuid
  purchase_id      String   @db.Uuid
  purchase_line_id String?  @db.Uuid // no foreign key on purpose: a removed line keeps its history
  type             String // CREATED | EDITED | FINAL_TOTAL_SET | LINE_ADDED | LINE_EDITED | LINE_REMOVED | CANCELLED | RECALCULATED
  qty              Int?
  before_json      Json?
  after_json       Json?
  note             String?
  created_by       String?  @db.Uuid
  created_at       DateTime @default(now())

  purchase purchases    @relation(fields: [purchase_id], references: [id])
  staff    staff_users? @relation(fields: [created_by], references: [id])

  @@index([purchase_id, created_at])
}

model product_categories {
  product_id  String     @db.Uuid
  category_id String     @db.Uuid
  product     products   @relation(fields: [product_id], references: [id])
  category    categories @relation(fields: [category_id], references: [id])

  @@id([product_id, category_id])
}

model product_media {
  id             String    @id @default(uuid()) @db.Uuid
  product_id     String    @db.Uuid
  media_type     MediaType
  url            String
  sort_order     Int       @default(0)
  is_main        Boolean   @default(false)
  title          String?
  // Optimized versions (D2): url = main WebP up to 1200 px, thumb = 400 px; JPEG fallbacks; size of the main one
  url_jpeg       String?
  thumb_url      String?
  thumb_url_jpeg String?
  width          Int?
  height         Int?
  product        products  @relation(fields: [product_id], references: [id])

  @@index([product_id])
}

model product_relations {
  id                 String       @id @default(uuid()) @db.Uuid
  product_id         String       @db.Uuid
  related_product_id String       @db.Uuid
  relation_type      RelationType
  sort_order         Int          @default(0)
  product            products     @relation("RelMain", fields: [product_id], references: [id])
  related            products     @relation("RelOther", fields: [related_product_id], references: [id])

  @@unique([product_id, related_product_id, relation_type])
}

// ───────────── INVENTORY ─────────────
model warehouses {
  id        String                @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  status    EntityStatus          @default(active)
  inventory inventory[]
  batches   inventory_batches[]
  movements inventory_movements[]
}

model inventory {
  id           String     @id @default(uuid()) @db.Uuid
  warehouse_id String     @db.Uuid
  product_id   String     @db.Uuid
  actual_qty   Int        @default(0)
  reserved_qty Int        @default(0)
  // available_qty = actual_qty - reserved_qty (computed, never stored)
  updated_at   DateTime   @updatedAt
  warehouse    warehouses @relation(fields: [warehouse_id], references: [id])
  product      products   @relation(fields: [product_id], references: [id])

  // CHECK (reserved_qty >= 0 AND actual_qty >= 0 AND reserved_qty <= actual_qty): constraints.sql
  @@unique([product_id, warehouse_id])
}

model inventory_batches {
  id           String     @id @default(uuid()) @db.Uuid
  warehouse_id String     @db.Uuid
  product_id   String     @db.Uuid
  batch_no     String?
  qty          Int
  cost_uzs     BigInt?
  received_at  DateTime   @default(now())
  expiry_date  DateTime?  @db.Date
  warehouse    warehouses @relation(fields: [warehouse_id], references: [id])
  product      products   @relation(fields: [product_id], references: [id])

  @@index([product_id, warehouse_id])
}

model inventory_movements {
  id             String       @id @default(uuid()) @db.Uuid
  warehouse_id   String       @db.Uuid
  product_id     String       @db.Uuid
  movement_type  MovementType
  qty            Int
  reference_type String?
  reference_id   String?      @db.Uuid
  reason         String?
  created_by     String?      @db.Uuid
  created_at     DateTime     @default(now())
  warehouse      warehouses   @relation(fields: [warehouse_id], references: [id])
  product        products     @relation(fields: [product_id], references: [id])
  staff          staff_users? @relation(fields: [created_by], references: [id])

  @@index([product_id, created_at])
  @@index([reference_type, reference_id])
}

// ───────────── CART / ORDERS ─────────────
model carts {
  id         String       @id @default(uuid()) @db.Uuid
  user_id    String       @db.Uuid
  status     CartStatus   @default(active)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  user       users        @relation(fields: [user_id], references: [id])
  items      cart_items[]

  // one active cart per user: partial unique index in constraints.sql
  @@index([user_id, status])
}

model cart_items {
  id                      String   @id @default(uuid()) @db.Uuid
  cart_id                 String   @db.Uuid
  product_id              String   @db.Uuid
  qty                     Int
  unit_price_snapshot_uzs BigInt
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  cart                    carts    @relation(fields: [cart_id], references: [id])
  product                 products @relation(fields: [product_id], references: [id])

  @@unique([cart_id, product_id])
}

model shipments {
  id         String   @id @default(uuid()) @db.Uuid
  note       String?
  created_at DateTime @default(now())
  orders     orders[]
}

model order_number_counters {
  day  DateTime @id @db.Date
  last Int      @default(0) // VTL-YYYYMMDD-NNNN, incremented atomically
}

model orders {
  id                             String        @id @default(uuid()) @db.Uuid
  order_number                   String        @unique
  user_id                        String        @db.Uuid
  status                         OrderStatus   @default(new)
  payment_status                 PaymentStatus @default(payment_pending)
  shipment_id                    String?       @db.Uuid
  recipient_name                 String
  recipient_phone                String
  region_id                      String        @db.Uuid
  city_id                        String        @db.Uuid
  address_text                   String
  latitude                       Decimal?      @db.Decimal(9, 6)
  longitude                      Decimal?      @db.Decimal(9, 6)
  customer_comment               String?
  delivery_method                String
  delivery_cost_uzs              BigInt
  goods_total_uzs                BigInt // before discounts
  discount_total_uzs             BigInt        @default(0)
  bonus_used_uzs                 BigInt        @default(0)
  goods_paid_uzs                 BigInt // goods after discounts, minus bonuses = real money part of goods
  total_uzs                      BigInt // money to pay = goods_paid + delivery
  promo_id                       String?       @db.Uuid
  bonus_rate_snapshot            Decimal?      @db.Decimal(6, 4)
  created_at                     DateTime      @default(now())
  paid_at                        DateTime?
  reserved_until                 DateTime?
  payment_reminder_sent_at       DateTime? // D3: "ждёт оплаты" reminder sent (once per order)
  payment_check_reminder_sent_at DateTime? // Stage 0.2: "payment not checked for N hours" sent to admins/managers (once per order)
  delivered_at                   DateTime?
  cancelled_at                   DateTime?
  /// Stage 2E: paid, but the units of unit-tracked lines could not be reserved (reason). «Нужно внимание склада»
  units_attention                String?
  /// Waybill number of the delivery service (BTS, Yandex Go…): optional, typed by the warehouse or the admin, printed on the label
  delivery_waybill               String?
  /// Stage 3: a test order (admin) — excluded from analytics, tax and summaries
  is_test                        Boolean       @default(false)
  /// Stage 3: what the delivery really cost US (free delivery for the customer), admin only
  own_delivery_cost_uzs          BigInt        @default(0)

  user            users                  @relation(fields: [user_id], references: [id])
  region          regions                @relation(fields: [region_id], references: [id])
  city            cities                 @relation(fields: [city_id], references: [id])
  promo           promotions?            @relation(fields: [promo_id], references: [id])
  shipment        shipments?             @relation(fields: [shipment_id], references: [id])
  items           order_items[]
  item_units      order_item_units[]
  history         order_status_history[]
  edits           order_edit_log[]
  payments        payments[]
  returns         returns[]
  promo_usages    promotion_usages[]
  ledger          bonus_ledger[]
  cancel_requests cancel_requests[]
  tasks           manager_tasks[]

  @@index([user_id, status, created_at])
  @@index([status, reserved_until]) // reservation-expiry job
}

model order_items {
  id                  String             @id @default(uuid()) @db.Uuid
  order_id            String             @db.Uuid
  product_id          String             @db.Uuid
  sku_snapshot        String
  name_ru_snapshot    String
  qty                 Int
  unit_price_uzs      BigInt
  line_total_uzs      BigInt
  discount_uzs        BigInt             @default(0)
  paid_line_total_uzs BigInt // actual paid price of line (basis for returns)
  order               orders             @relation(fields: [order_id], references: [id])
  product             products           @relation(fields: [product_id], references: [id])
  return_items        return_items[]
  units               order_item_units[]

  @@index([order_id])
}

model order_status_history {
  id              String    @id @default(uuid()) @db.Uuid
  order_id        String    @db.Uuid
  from_status     String?
  to_status       String
  reason          String?
  changed_by_type ActorType
  changed_by_id   String?   @db.Uuid
  created_at      DateTime  @default(now())
  order           orders    @relation(fields: [order_id], references: [id])

  @@index([order_id, created_at])
}

model order_edit_log {
  id            String      @id @default(uuid()) @db.Uuid
  order_id      String      @db.Uuid
  staff_user_id String      @db.Uuid
  before_json   Json
  after_json    Json
  reason        String
  created_at    DateTime    @default(now())
  order         orders      @relation(fields: [order_id], references: [id])
  staff         staff_users @relation(fields: [staff_user_id], references: [id])
}

model cancel_requests {
  id            String              @id @default(uuid()) @db.Uuid
  order_id      String              @db.Uuid
  user_id       String              @db.Uuid
  status        CancelRequestStatus @default(requested)
  reason        String?
  decided_by    String?             @db.Uuid
  reject_reason String? // mandatory when rejected
  created_at    DateTime            @default(now())
  decided_at    DateTime?
  order         orders              @relation(fields: [order_id], references: [id])
  user          users               @relation(fields: [user_id], references: [id])
  staff         staff_users?        @relation(fields: [decided_by], references: [id])
}

// ───────────── PAYMENTS ─────────────
model payment_methods {
  id              String              @id @default(uuid()) @db.Uuid
  code            String              @unique // payme | click | uzum | bank_transfer
  name_ru         String
  name_uz         String?
  status          PaymentMethodStatus @default(enabled)
  timeout_minutes Int
  config_json     Json? // NO plaintext secrets: store refs to env/secret manager
  payments        payments[]
}

model payments {
  id                  String                         @id @default(uuid()) @db.Uuid
  order_id            String                         @db.Uuid
  payment_method_id   String                         @db.Uuid
  amount_uzs          BigInt
  status              PaymentStatus                  @default(payment_pending)
  provider_payment_id String?
  // 2.1, online payments: where the customer is sent to pay, and when that link stops working
  checkout_url        String?
  expires_at          DateTime?
  created_at          DateTime                       @default(now())
  updated_at          DateTime                       @updatedAt
  paid_at             DateTime?
  order               orders                         @relation(fields: [order_id], references: [id])
  method              payment_methods                @relation(fields: [payment_method_id], references: [id])
  attempts            payment_attempts[]
  manual              manual_payment_confirmations[]

  @@unique([payment_method_id, provider_payment_id]) // webhook duplicate protection
  @@index([order_id, status])
}

model payment_attempts {
  id                     String        @id @default(uuid()) @db.Uuid
  payment_id             String        @db.Uuid
  attempt_no             Int
  status                 AttemptStatus @default(pending)
  provider_request_id    String?
  provider_response_json Json?
  created_at             DateTime      @default(now())
  payment                payments      @relation(fields: [payment_id], references: [id])

  @@unique([payment_id, attempt_no])
}

model manual_payment_confirmations {
  id                    String       @id @default(uuid()) @db.Uuid
  payment_id            String       @db.Uuid
  receipt_url           String?
  customer_confirmed_at DateTime?
  verified_by           String?      @db.Uuid
  verified_at           DateTime?
  comment               String?
  payment               payments     @relation(fields: [payment_id], references: [id])
  staff                 staff_users? @relation(fields: [verified_by], references: [id])
}

model manager_tasks {
  id          String       @id @default(uuid()) @db.Uuid
  type        TaskType
  order_id    String?      @db.Uuid
  status      TaskStatus   @default(open)
  note        String?
  assigned_to String?      @db.Uuid
  created_at  DateTime     @default(now())
  done_at     DateTime?
  order       orders?      @relation(fields: [order_id], references: [id])
  staff       staff_users? @relation(fields: [assigned_to], references: [id])

  @@index([status, type])
}

// ───────────── PROMOTIONS ─────────────
model promotions {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  type               PromoType
  value              Decimal             @db.Decimal(12, 2)
  start_at           DateTime
  end_at             DateTime
  min_order_uzs      BigInt?
  max_discount_uzs   BigInt?
  global_limit       Int?
  per_customer_limit Int?
  stacking_mode      StackingMode        @default(exclusive)
  status             PromoStatus         @default(draft)
  scope_type         PromoScope          @default(order)
  targets            promotion_targets[]
  usages             promotion_usages[]
  codes              promo_codes[]
  orders             orders[]
}

model promotion_targets {
  id           String      @id @default(uuid()) @db.Uuid
  promotion_id String      @db.Uuid
  product_id   String?     @db.Uuid
  category_id  String?     @db.Uuid
  brand        String?
  promotion    promotions  @relation(fields: [promotion_id], references: [id])
  product      products?   @relation(fields: [product_id], references: [id])
  category     categories? @relation(fields: [category_id], references: [id])
}

model promotion_usages {
  id           String           @id @default(uuid()) @db.Uuid
  promotion_id String           @db.Uuid
  user_id      String           @db.Uuid
  order_id     String           @db.Uuid
  discount_uzs BigInt
  status       PromoUsageStatus @default(reserved)
  created_at   DateTime         @default(now())
  promotion    promotions       @relation(fields: [promotion_id], references: [id])
  user         users            @relation(fields: [user_id], references: [id])
  order        orders           @relation(fields: [order_id], references: [id])

  @@index([promotion_id, user_id])
}

model promo_codes {
  id           String          @id @default(uuid()) @db.Uuid
  promotion_id String          @db.Uuid
  code         String          @unique
  status       PromoCodeStatus @default(active)
  promotion    promotions      @relation(fields: [promotion_id], references: [id])
}

// ───────────── BONUSES / REFERRAL ─────────────
model bonus_accounts {
  id          String         @id @default(uuid()) @db.Uuid
  user_id     String         @unique @db.Uuid
  balance_uzs BigInt         @default(0)
  updated_at  DateTime       @updatedAt
  user        users          @relation(fields: [user_id], references: [id])
  ledger      bonus_ledger[]
  // CHECK (balance_uzs >= 0): constraints.sql
}

// Immutable: UPDATE/DELETE blocked by trigger (constraints.sql)
model bonus_ledger {
  id                String         @id @default(uuid()) @db.Uuid
  bonus_account_id  String         @db.Uuid
  operation_type    BonusOp
  amount_uzs        BigInt
  balance_after_uzs BigInt
  order_id          String?        @db.Uuid
  reference_id      String?        @db.Uuid
  idempotency_ref   String?        @unique // e.g. "purchase:<orderId>" -> no double accrual on webhook replay
  reason            String?
  created_by        String?        @db.Uuid
  created_at        DateTime       @default(now())
  account           bonus_accounts @relation(fields: [bonus_account_id], references: [id])
  order             orders?        @relation(fields: [order_id], references: [id])
  staff             staff_users?   @relation(fields: [created_by], references: [id])

  @@index([bonus_account_id, created_at])
}

model referrals {
  id              String                  @id @default(uuid()) @db.Uuid
  inviter_user_id String                  @db.Uuid
  referral_code   String                  @unique
  created_at      DateTime                @default(now())
  inviter         users                   @relation(fields: [inviter_user_id], references: [id])
  attributions    referral_attributions[]
}

model referral_attributions {
  id              String         @id @default(uuid()) @db.Uuid
  referral_id     String         @db.Uuid
  invited_user_id String         @unique @db.Uuid // one reward per new user
  first_order_id  String?        @db.Uuid
  status          ReferralStatus @default(pending)
  expires_at      DateTime // registration + 30 days
  referral        referrals      @relation(fields: [referral_id], references: [id])
  invited         users          @relation(fields: [invited_user_id], references: [id])
}

// ───────────── DELIVERY ─────────────
model delivery_tariffs {
  id                          String       @id @default(uuid()) @db.Uuid
  region_id                   String       @db.Uuid
  city_id                     String?      @db.Uuid
  tariff_uzs                  BigInt
  free_shipping_threshold_uzs BigInt
  status                      TariffStatus @default(active)
  min_days                    Int? // delivery term, working days; NULL on a city tariff = take the region one
  max_days                    Int?
  note_ru                     String?
  note_uz                     String?
  is_test                     Boolean      @default(false) // created automatically, "test, check" in the admin
  region                      regions      @relation(fields: [region_id], references: [id])
  city                        cities?      @relation(fields: [city_id], references: [id])

  @@index([region_id, city_id])
}

// ───────────── RETURNS ─────────────
model returns {
  id                String         @id @default(uuid()) @db.Uuid
  order_id          String         @db.Uuid
  user_id           String         @db.Uuid
  status            ReturnStatus   @default(requested)
  reason            ReturnReason
  comment           String? // required when reason = other (app validation)
  reject_reason     String? // required when rejected
  created_at        DateTime       @default(now())
  approved_by       String?        @db.Uuid
  approved_at       DateTime?
  refund_amount_uzs BigInt?
  refunded_at       DateTime?
  refund_comment    String?
  order             orders         @relation(fields: [order_id], references: [id])
  user              users          @relation(fields: [user_id], references: [id])
  staff             staff_users?   @relation(fields: [approved_by], references: [id])
  items             return_items[]
  media             return_media[]
}

model return_items {
  id                String           @id @default(uuid()) @db.Uuid
  return_id         String           @db.Uuid
  order_item_id     String           @db.Uuid
  qty               Int
  refund_amount_uzs BigInt
  condition         ReturnCondition?
  return            returns          @relation(fields: [return_id], references: [id])
  order_item        order_items      @relation(fields: [order_item_id], references: [id])
}

model return_media {
  id        String  @id @default(uuid()) @db.Uuid
  return_id String  @db.Uuid
  url       String
  return    returns @relation(fields: [return_id], references: [id])
}

// ───────────── CONTENT / MARKETING ─────────────
model content_blocks {
  id                String                @id @default(uuid()) @db.Uuid
  type              ContentBlockType
  title_ru          String?
  title_uz          String?
  image_url         String?
  sort_order        Int                   @default(0)
  status            ContentStatus         @default(active)
  start_at          DateTime?
  end_at            DateTime?
  click_target_type ClickTarget?
  click_target_id   String?
  external_url      String?
  items             content_block_items[]
}

model content_block_items {
  id               String         @id @default(uuid()) @db.Uuid
  content_block_id String         @db.Uuid
  product_id       String?        @db.Uuid
  category_id      String?        @db.Uuid
  sort_order       Int            @default(0)
  block            content_blocks @relation(fields: [content_block_id], references: [id])
  product          products?      @relation(fields: [product_id], references: [id])
  category         categories?    @relation(fields: [category_id], references: [id])
}

model favorites {
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  created_at DateTime @default(now())
  user       users    @relation(fields: [user_id], references: [id])
  product    products @relation(fields: [product_id], references: [id])

  @@id([user_id, product_id])
}

model marketing_campaigns {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  segment_type    SegmentType
  text_ru         String
  text_uz         String?
  image_url       String?
  button_text     String         @default("Открыть магазин")
  status          CampaignStatus @default(draft)
  recipient_count Int?
  sent_count      Int?
  delivered_count Int?
  error_count     Int?
  created_by      String         @db.Uuid
  created_at      DateTime       @default(now())
  staff           staff_users    @relation(fields: [created_by], references: [id])
}

model notifications {
  id              String       @id @default(uuid()) @db.Uuid
  user_id         String?      @db.Uuid // customer recipient, or
  staff_user_id   String?      @db.Uuid // employee recipient
  chat_id         BigInt // Telegram chat = Telegram user id of the recipient
  kind            String // service (always sent) | marketing (only with users.marketing_opt_in)
  template        String // e.g. order.paid, staff.new_order (see notification-templates.ts)
  payload         Json? // template variables + lang
  status          String       @default("queued") // queued | sending | sent | failed | skipped
  attempts        Int          @default(0)
  next_attempt_at DateTime     @default(now())
  error           String?
  created_at      DateTime     @default(now())
  sent_at         DateTime?
  user            users?       @relation(fields: [user_id], references: [id])
  staff           staff_users? @relation(fields: [staff_user_id], references: [id])

  @@index([user_id, created_at])
  @@index([status, next_attempt_at])
}

// ───────────── LEGAL / AUDIT / TECH ─────────────
model legal_documents {
  id           String              @id @default(uuid()) @db.Uuid
  code         String
  version      String
  text_ru      String
  text_uz      String?
  status       LegalStatus         @default(draft)
  published_at DateTime?
  acceptances  legal_acceptances[]

  @@unique([code, version])
}

model legal_acceptances {
  id                String          @id @default(uuid()) @db.Uuid
  user_id           String          @db.Uuid
  legal_document_id String          @db.Uuid
  accepted_at       DateTime        @default(now())
  source            String // bot | mini_app
  user              users           @relation(fields: [user_id], references: [id])
  document          legal_documents @relation(fields: [legal_document_id], references: [id])

  @@index([user_id])
}

model audit_logs {
  id            String       @id @default(uuid()) @db.Uuid
  staff_user_id String?      @db.Uuid
  action        String
  entity_type   String
  entity_id     String?      @db.Uuid
  before_json   Json?
  after_json    Json?
  ip            String?
  created_at    DateTime     @default(now())
  staff         staff_users? @relation(fields: [staff_user_id], references: [id])

  @@index([entity_type, entity_id, created_at])
}

model system_errors {
  id           String    @id @default(uuid()) @db.Uuid
  level        String
  service      String
  message      String
  stack_trace  String?
  context_json Json?
  notified_at  DateTime?
  created_at   DateTime  @default(now())
}

model idempotency_keys {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique
  scope         String
  request_hash  String
  response_json Json?
  created_at    DateTime @default(now())
  expires_at    DateTime
}

/// Stage 2.1: banners of the Mini App home screen (up to 5, Настройки → Главная → Баннеры).
/// kind: doctor = «Отбор врачом • 4,9 на Яндекс Маркете», delivery = the delivery offer (both drawn by the Mini App);
/// image = a picture uploaded in the admin panel (RU and/or UZ, 3:1, stored as WebP + JPEG).
model home_banners {
  id            String    @id @default(uuid()) @db.Uuid
  kind          String
  enabled       Boolean   @default(true)
  sort_order    Int       @default(0)
  image_ru_url  String?
  image_ru_jpeg String?
  image_uz_url  String?
  image_uz_jpeg String?
  /// product | category | brand; null = the banner is not a link
  link_type     String?
  /// product id, category slug or brand name
  link_value    String?
  starts_at     DateTime?
  ends_at       DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([sort_order])
}

model settings {
  key        String   @id // bonus_rate, referral_bonus_uzs, min_order_for_bonus_uzs, support_contact, ...
  value      Json
  updated_at DateTime @updatedAt
}

model sales_daily {
  date                 DateTime @id @db.Date
  orders_count         Int
  revenue_uzs          BigInt
  goods_revenue_uzs    BigInt
  delivery_revenue_uzs BigInt
  discount_uzs         BigInt
  bonus_used_uzs       BigInt
  cost_uzs             BigInt?
  updated_at           DateTime @updatedAt
}

/// Internal funnel analytics (B3): app_open, product_view, add_to_cart, checkout_start, order_created, payment_marked, payment_confirmed.
model analytics_events {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  event      String
  props      Json?
  created_at DateTime @default(now())
  user       users    @relation(fields: [user_id], references: [id])

  @@index([event, created_at])
  @@index([user_id, created_at])
}
