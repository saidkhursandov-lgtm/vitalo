# --- API ---
NODE_ENV=development
DATABASE_URL=postgresql://vitalo:vitalo@localhost:5432/vitalo_dev   # local working DB (tests: vitalo_test; the server's DB is vitalo)
REDIS_URL=redis://localhost:6379
PORT=3000
TELEGRAM_BOT_TOKEN=            # from @BotFather (for local dev any "123:abc" works with npm run dev:login)
BOT_API_SECRET=                # random 64 hex chars; the bot uses it for /api/internal/bot/*
CORS_ORIGINS=                  # comma separated browser origins; empty = localhost dev servers (none in production)
MINIAPP_URL=                   # public https URL of the Mini App (production); dev tunnel writes .runtime/miniapp-url.txt
ADMIN_URL=                     # public https URL of the admin panel (production)
TECH_CHAT_ID=                  # technical Telegram chat for system errors
SESSION_TTL_HOURS=720
STAFF_SESSION_TTL_HOURS=12
INIT_DATA_MAX_AGE_SECONDS=3600
JOBS_ENABLED=true              # background jobs (reservation expiry); false = off
# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vitalo-media
S3_ACCESS_KEY=vitalo
S3_SECRET_KEY=vitalo-secret
# --- Online payments Payme / Click / Uzum (D-20). Values only in .env, never in DB, docs or git.
# Empty = not connected: the system can only be «Скрыта» or «Скоро» (Настройки → Оплата). ---
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
UZUM_SERVICE_ID=
UZUM_SECRET=
