# --- API ---
NODE_ENV=development
DATABASE_URL=postgresql://vitalo:vitalo@localhost:5432/vitalo
REDIS_URL=redis://localhost:6379
PORT=3000
TELEGRAM_BOT_TOKEN=            # from @BotFather (for local dev any "123:abc" works with npm run dev:login)
