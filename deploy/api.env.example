# Template for /opt/vitalo/app/apps/api/.env on the server (the API and the bot read this file).
# Only names and safe defaults here. Real values are typed on the server and never go to git or chat.
# File rights: chmod 600, owner vitalo.

NODE_ENV=production
# The API listens only on this machine; nginx is the only way in from outside.
HOST=127.0.0.1
PORT=3000

# PostgreSQL through the local socket as the `vitalo` system user: no password is stored anywhere.
DATABASE_URL=postgresql://vitalo@localhost/vitalo?host=/var/run/postgresql

# Token of the PRODUCTION bot from @BotFather (not the test one).
TELEGRAM_BOT_TOKEN=
# Shared secret between the bot and the API: openssl rand -hex 32
BOT_API_SECRET=
# Telegram group for system errors (e.g. -1001234567890); empty = no alerts.
TECH_CHAT_ID=

# The bot calls the API here (IPv4 on purpose: the API listens only on 127.0.0.1, "localhost" may resolve to ::1).
API_INTERNAL_URL=http://127.0.0.1:3000/api

# Public addresses
MINIAPP_URL=https://vitalo.uz
ADMIN_URL=https://admin.vitalo.uz
CORS_ORIGINS=https://vitalo.uz,https://admin.vitalo.uz

# Product photos (served by nginx from this folder at /uploads/)
UPLOAD_DIR=/var/lib/vitalo/uploads
PUBLIC_UPLOADS_URL=/uploads

# Sessions and Telegram sign-in
SESSION_TTL_HOURS=720
STAFF_SESSION_TTL_HOURS=12
INIT_DATA_MAX_AGE_SECONDS=86400

# Background jobs (expired reservations, payment reminders, notifications): exactly one API instance runs them.
JOBS_ENABLED=true
# API docs at /api/docs stay off in production unless this is true.
API_DOCS=false

# Stage 2D: Yandex Market orders, READ ONLY (docs/operations/STAGE_2D_REPORT.md).
# API-Key token of the seller cabinet, scope «inventory-and-order-processing:read-only». Never commit it.
YANDEX_API_KEY=
YANDEX_BUSINESS_ID=216755072
# Campaigns to take orders from, comma separated (VITALO_h)
YANDEX_CAMPAIGN_IDS=149165806
# Poll: off by default; DRY_RUN=true writes only the run log («что было бы сделано»)
YANDEX_SYNC_ENABLED=false
YANDEX_SYNC_DRY_RUN=true
YANDEX_SYNC_INTERVAL_MINUTES=5
YANDEX_SYNC_DAYS=3
YANDEX_SYNC_FIRST_DAYS=14
# Notifications from Yandex: off until the server address is registered in the cabinet.
# URL: https://<admin or api domain>/api/yandex/notifications/<YANDEX_WEBHOOK_SECRET>  (secret: 16+ random chars)
YANDEX_WEBHOOK_ENABLED=false
YANDEX_WEBHOOK_SECRET=
